From ac6a32e2ed021acda8b03c3f4bf5d497e492771b Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Mon, 23 Nov 2026 04:55:49 -0500
Subject: [PATCH 3/3] yotonym03: power key, buffering every tick, yield in skin
 rendering

- Power: PMU+0x2c bit 1 (level). Hold = power off, tap in Now Playing =
  pause/resume; Back stays the plugins' Power key
- buffering polls every tick on small-memory targets (CD-quality PCM
  empties the few-KiB file buffer in ~40 ms)
- UI yield point at the start of each skin viewport render (the first
  Now Playing draw could outlast the PCM buffer)
- test hooks: power key search

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/buffering.c                              |   5 +-
 apps/gui/skin_engine/skin_render.c            |   5 +
 apps/keymaps/keymap-yotonym03.c               |   1 +
 apps/main.c                                   | 148 ++++++++++++++++++
 apps/plugin.h                                 |   4 +-
 .../arm/atj2157/yotonym03/button-target.h     |  12 +-
 .../arm/atj2157/yotonym03/button-yotonym03.c  |   5 +
 7 files changed, 171 insertions(+), 9 deletions(-)

diff --git a/apps/buffering.c b/apps/buffering.c
index 5867cf3..e8c3740 100644
--- a/apps/buffering.c
+++ b/apps/buffering.c
@@ -1607,8 +1607,9 @@ static void NORETURN_ATTR buffering_thread(void)
                 cancel_cpu_boost();
             }
 #if MEMORYSIZE < 2
-            /* a few KiB of buffer last a fraction of a second: look often */
-            queue_wait_w_tmo(&buffering_queue, &ev, filling ? 1 : HZ/20);
+            /* a few KiB of buffer last a fraction of a second (~40 ms of
+               CD-quality PCM): look every tick */
+            queue_wait_w_tmo(&buffering_queue, &ev, 1);
 #else
             queue_wait_w_tmo(&buffering_queue, &ev, filling ? 1 : HZ/2);
 #endif
diff --git a/apps/gui/skin_engine/skin_render.c b/apps/gui/skin_engine/skin_render.c
index 5c731e0..9810625 100644
--- a/apps/gui/skin_engine/skin_render.c
+++ b/apps/gui/skin_engine/skin_render.c
@@ -745,6 +745,11 @@ bool skin_render_alternator(struct skin_element* element, struct skin_draw_info
 void skin_render_viewport(struct skin_element* viewport, struct gui_wps *gwps,
                         struct skin_viewport* skin_viewport, unsigned long refresh_type)
