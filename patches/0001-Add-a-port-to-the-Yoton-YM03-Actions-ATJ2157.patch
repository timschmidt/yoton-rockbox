+#if MEMORYSIZE < 2
+/* compact allocation list for out-of-memory panics on tiny targets:
+ * "bytes:ops" per allocated block, "-bytes" per free one */
+void buflib_dump_short(struct buflib_context *ctx, char *buf, size_t bufsize)
+{
+    size_t n = 0;
+    buf[0] = '\0';
+    for(union buflib_data *block = ctx->buf_start;
+        block < ctx->alloc_end && n + 16 < bufsize;
+        block += abs(block->val))
+    {
+        long len = (long)block->val * (long)sizeof(union buflib_data);
+        if (len < 0)
+            n += snprintf(buf + n, bufsize - n, "-%ld ", -len);
+        else
+            n += snprintf(buf + n, bufsize - n, "%ld:%lx ", len,
+                    (unsigned long)((uintptr_t)block[BUFLIB_IDX_OPS].ops & 0xfffff));
+        if (len == 0)
+            break;
+    }
+}
+#endif
