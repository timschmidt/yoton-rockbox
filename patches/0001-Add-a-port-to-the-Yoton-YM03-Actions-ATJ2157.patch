diff --git a/firmware/export/atj2157.h b/firmware/export/atj2157.h
new file mode 100644
index 0000000..a00a746
--- /dev/null
+++ b/firmware/export/atj2157.h
@@ -0,0 +1,147 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * Actions Semiconductor ATJ2157 (ARM Cortex-M4) register definitions.
+ *
+ * Everything here was recovered by reverse engineering the mask ROM and
+ * the vendor firmware of a Yoton YM03, and verified on hardware unless
+ * marked otherwise.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#ifndef __ATJ2157_H__
+#define __ATJ2157_H__
+
+#define ATJ_REG(a)          (*(volatile uint32_t *)(a))
+
+/* no cache; align DMA buffers to 32 bytes anyway */
+#define CACHEALIGN_BITS     5
+#define CACHEALIGN_SIZE     32
+
+/* Memory map (CPU view) */
+#define ATJ_ROM_BASE        0x00000000  /* 64 KiB mask ROM */
+#define ATJ_SRAM0_BASE      0x00100000  /* 224 KiB */
+#define ATJ_SRAM0_SIZE      0x00038000
+#define ATJ_SRAM1_BASE      0x00158000  /* 32 KiB */
+#define ATJ_SRAM1_SIZE      0x00008000
+#define ATJ_SRAM2_BASE      0x00200000  /* 32 KiB (aliased over 1 MiB) */
+#define ATJ_SRAM2_SIZE      0x00008000
+#define ATJ_SRAM3_BASE      0x00300000  /* 32 KiB (aliased over 1 MiB) */
+#define ATJ_SRAM3_SIZE      0x00008000
+
+/* Reset (RMU) and clock (CMU) control: a set bit releases reset / gates on */
+#define RMU_RST0            ATJ_REG(0xc0000000)
+#define RMU_RST1            ATJ_REG(0xc0000004)
+#define CMU_SYSCLK          ATJ_REG(0xc0001000)
+#define CMU_CLKEN0          ATJ_REG(0xc0001008)
+#define CMU_CLKEN1          ATJ_REG(0xc000100c)
+
+/* RTC-block timer T0 runs from the 24 MHz HOSC */
+#define TIMER_FREQ          24000000
+#define CMU_SD0CLK          ATJ_REG(0xc0001014)
+#define CMU_SPI0CLK         ATJ_REG(0xc0001020)
+#define CMU_LCDCLK          ATJ_REG(0xc0001034)
+#define CMU_PWMCLK(n)       ATJ_REG(0xc0001050 + 4 * (n))
+#define CMU_ADCCLK          ATJ_REG(0xc0001080)
+#define CMU_DACCLK          ATJ_REG(0xc0001088)
+
+#define CLKEN0_BIT0         (1 << 0)
+#define CLKEN0_SD0          (1 << 2)
+#define CLKEN0_SPI0         (1 << 6)
+#define CLKEN0_LCM          (1 << 13)
+#define CLKEN0_PWM          (1 << 25)
+
+/* PMU (power, ADCs) */
+#define PMU_BASE            0xc0010000
+#define PMU_CTL0            ATJ_REG(PMU_BASE + 0x20)   /* power-off sequence */
+#define PMU_STAT            ATJ_REG(PMU_BASE + 0x28)
+#define PMU_BATADC          ATJ_REG(PMU_BASE + 0x3c)   /* 10 bit */
+#define PMU_LRADC(n)        ATJ_REG(PMU_BASE + 0x50 + 4 * ((n) - 1)) /* 10 bit */
+
+/* RTC / watchdog */
+#define RTC_BASE            0xc0030000
+#define RTC_WDCTL           ATJ_REG(RTC_BASE + 0x1c)   /* bit0: clear watchdog */
+
+/* DMA controller: channel n at 0xc0070100 + 0x100*n */
+#define DMA_IRQPD           ATJ_REG(0xc0070000)
+#define DMA_IRQEN           ATJ_REG(0xc0070004)
+#define DMA_MODE(n)         ATJ_REG(0xc0070100 + 0x100 * (n))
+#define DMA_CTL(n)          ATJ_REG(0xc0070104 + 0x100 * (n))  /* bit0 start/busy */
+#define DMA_SRC(n)          ATJ_REG(0xc0070108 + 0x100 * (n))
+#define DMA_DST(n)          ATJ_REG(0xc0070110 + 0x100 * (n))
+#define DMA_LEN(n)          ATJ_REG(0xc0070118 + 0x100 * (n))
+#define DMA_MODE_SD0_READ   0x85        /* source = SD0 FIFO */
+#define DMA_MODE_SD0_WRITE  0x8500      /* destination = SD0 FIFO */
+
+/* SPI0 (NOR flash) */
+#define SPI0_CTL            ATJ_REG(0xc00a0000)
+#define SPI0_STAT           ATJ_REG(0xc00a0004)
+#define SPI0_TXDAT          ATJ_REG(0xc00a0008)
+#define SPI0_RXDAT          ATJ_REG(0xc00a000c)
+#define SPI0_BC             ATJ_REG(0xc00a0010)
+
+/* USB device controller */
+#define USB_BASE            0xc0140000
+
+/* SD/MMC controller 0 */
+#define SD0_BASE            0xc0160000
+#define SD_EN               ATJ_REG(SD0_BASE + 0x00)   /* bits 1:0 bus width */
+#define SD_CTL              ATJ_REG(SD0_BASE + 0x04)
+#define SD_STATE            ATJ_REG(SD0_BASE + 0x08)
+#define SD_CMD              ATJ_REG(SD0_BASE + 0x0c)
+#define SD_ARG              ATJ_REG(SD0_BASE + 0x10)
+#define SD_RSPBUF(n)        ATJ_REG(SD0_BASE + 0x14 + 4 * (n))
+#define SD_DAT              (SD0_BASE + 0x28)
+#define SD_BLKSZ            ATJ_REG(SD0_BASE + 0x2c)
+#define SD_BLKNUM           ATJ_REG(SD0_BASE + 0x30)
+
+#define SD_CTL_START        (1u << 7)
+#define SD_CTL_INITCLK      (1u << 12)
+#define SD_CTL_TIMING       0x8f0000
+#define SD_CTL_DATA         (0x80000000u | 0x3f000000u)
+#define SD_TYPE_NONE        0
+#define SD_TYPE_R1          1
+#define SD_TYPE_R2          2
+#define SD_TYPE_R3          3
+#define SD_TYPE_RDATA       4
+#define SD_TYPE_WDATA       5
+#define SD_STATE_ERRMASK    0x8017
+
+/* PWM: channel n at 0xc0190000 + 0x100*n */
+#define PWM_CTL(n)          ATJ_REG(0xc0190000 + 0x100 * (n))
+#define PWM_PERIOD(n)       ATJ_REG(0xc0190014 + 0x100 * (n))
+#define PWM_DUTY(n)         ATJ_REG(0xc0190018 + 0x100 * (n))
+
+/* LCD module controller (8080 bus) */
+#define LCM_CTL             ATJ_REG(0xc01a0000)
+#define LCM_RS              ATJ_REG(0xc01a0010)
+#define LCM_DATA            ATJ_REG(0xc01a0014)
+
+/* Pin multiplexing and GPIO */
+#define MFP_CTL(pin)        ATJ_REG(0xc01c0004 + 4 * (pin))
+#define MFP_FUNC_MASK       0x1f
+#define MFP_GPIO_OUT        (1 << 6)
+#define MFP_DRIVE(n)        ((n) << 12)
+#define GPIO_OUTEN(bank)    ATJ_REG(0xc01c0200 + 4 * (bank))
+#define GPIO_SET(bank)      ATJ_REG(0xc01c0210 + 4 * (bank))
+#define GPIO_CLR(bank)      ATJ_REG(0xc01c0220 + 4 * (bank))
+#define GPIO_IN(bank)       ATJ_REG(0xc01c0230 + 4 * (bank))
+
+/* NVIC interrupt numbers (only those identified so far) */
+#define ATJ_IRQ_USB         12
+#define ATJ_IRQ_DMA         31
+#define ATJ_IRQ_TIMER0      2
+
+#endif /* __ATJ2157_H__ */
