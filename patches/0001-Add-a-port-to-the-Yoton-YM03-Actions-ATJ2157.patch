+#include "button-target.h"
+#include "common.h"
+#include "rb-loader.h"
+#include "loader_strerror.h"
+#include "storage.h"
+#include "disk.h"
+#include "file.h"
+#include "file_internal.h"
+#include "power.h"
+#include "rbversion.h"
+#include "version.h"
+#include "sysfont.h"
+#include "powermgmt.h"
+#include "tick.h"
+
+#define LOAD_ADDR   0x00100000
+#define LOAD_SIZE   0x00024000      /* up to the bootloader image */
+
+/* Shared with the host-side tooling: last status word, readable over ADFU */
+volatile uint32_t ym03_boot_status __attribute__((used));
+
+/*
+ * Test mode: if the loader (ymon) left this magic at TESTMODE_ADDR, the
+ * bootloader reboots after a few seconds instead of waiting forever. SRAM
+ * survives the reset, so the host can read ym03_boot_status and the frame
+ * buffer back through the boot ROM ADFU mode.
+ */
+#define TESTMODE_ADDR   (*(volatile uint32_t *)0x0011fff0)
+#define TESTMODE_MAGIC  0x54535459
+static bool testmode;
+
+/* In test mode a hung main thread must not keep the device hostage: the
+ * tick task forces a reboot after a fixed deadline. */
+#define TESTMODE_DEADLINE   (10 * HZ)
+static void test_deadline_tick(void)
+{
+    if (current_tick > TESTMODE_DEADLINE)
+        system_reboot();
+}
+
+static void test_exit(void)
+{
+    if (testmode)
+    {
+        sleep(3 * HZ);
+        system_reboot();
+    }
+}
+
+static void list_root(void)
+{
+    DIR *d = opendir("/");
+    struct dirent *e;
+    int n = 0;
+    if (!d)
+    {
+        printf("opendir / failed");
+        return;
+    }
+    while ((e = readdir(d)) != NULL && n < 5)
+    {
+        if (e->d_name[0] == '.')
+            continue;
+        printf(" %s", e->d_name);
+        n++;
+    }
+    closedir(d);
+}
+
+static void diag_loop(void)
+{
+    char buf[32];
+
+    while (1)
+    {
+        unsigned adc = button_read_raw_adc();
+        unsigned gpio = button_read_raw_gpio();
+
+        lcd_set_foreground(LCD_WHITE);
+        lcd_fillrect(0, LCD_HEIGHT - 3 * SYSFONT_HEIGHT, LCD_WIDTH,
+                     3 * SYSFONT_HEIGHT);
+        lcd_set_drawmode(DRMODE_SOLID);
+        snprintf(buf, sizeof(buf), "key adc %03x", adc);
+        lcd_putsxy(0, LCD_HEIGHT - 3 * SYSFONT_HEIGHT, buf);
+        snprintf(buf, sizeof(buf), "key gpio %08x", gpio);
+        lcd_putsxy(0, LCD_HEIGHT - 2 * SYSFONT_HEIGHT, buf);
+        snprintf(buf, sizeof(buf), "batt %d mV", _battery_voltage());
+        lcd_putsxy(0, LCD_HEIGHT - 1 * SYSFONT_HEIGHT, buf);
+        lcd_update_rect(0, LCD_HEIGHT - 3 * SYSFONT_HEIGHT, LCD_WIDTH,
+                        3 * SYSFONT_HEIGHT);
+        sleep(HZ / 10);
+        test_exit();
+    }
+}
+
+void main(void) NORETURN_ATTR;
+void main(void)
+{
+    int ret;
+
+    testmode = TESTMODE_ADDR == TESTMODE_MAGIC;
+    TESTMODE_ADDR = 0;
+    ym03_boot_status = 1;
+    system_init();
+    kernel_init();
+    if (testmode)
+        tick_add_task(test_deadline_tick);
+    enable_irq();
+    ym03_boot_status = 2;
+
+    lcd_init();
+    backlight_init();
+    button_init_device();
+    ym03_boot_status = 3;
+
+    verbose = true;
+    lcd_clear_display();
+    printf("Rockbox boot loader");
+    printf("Version %s", rbversion);
+    printf("%s", MODEL_NAME);
+
+    ret = storage_init();
+    ym03_boot_status = 0x100 | (ret & 0xff);
+    if (ret < 0)
+    {
+        printf("Storage init: %d", ret);
+        diag_loop();
+    }
+
+    filesystem_init();
+    {
+        static unsigned char sec[512] __attribute__((aligned(32)));
+        struct storage_info info;
+        storage_get_info(0, &info);
+        printf("SD %lu sectors", (unsigned long)info.num_sectors);
+        int r = storage_read_sectors(IF_MD(0,) 0, 1, sec);
+        printf("rd0 %d sig %02x%02x t%02x", r, sec[510], sec[511], sec[450]);
+        extern uint32_t ym03_sd_trace[16][2];
+        extern unsigned ym03_sd_trace_pos;
+        for (unsigned i = ym03_sd_trace_pos - 4; i != ym03_sd_trace_pos; i++)
+            printf("%08lx %08lx", (unsigned long)ym03_sd_trace[i & 15][0],
+                   (unsigned long)ym03_sd_trace[i & 15][1]);
+    }
+
+    ret = disk_mount_all();
+    ym03_boot_status = 0x200 | (ret & 0xff);
+    if (ret <= 0)
+    {
+        printf("No partition: %d", ret);
+        diag_loop();
+    }
+    printf("Mounted %d volume(s)", ret);
+    list_root();
+
+    printf("Loading %s", BOOTFILE);
+    ret = load_firmware((unsigned char *)LOAD_ADDR, BOOTFILE, LOAD_SIZE);
+    ym03_boot_status = 0x300 | (ret & 0xff);
+    if (ret <= EFILE_EMPTY)
+    {
+        printf("Load failed:");
+        printf("%s", loader_strerror(ret));
+        diag_loop();
+    }
+
+    printf("Starting...");
+    ym03_boot_status = 0x400;
+    disable_irq();
+    ((void (*)(void))(LOAD_ADDR | 1))();
+    while (1);
+}
