diff --git a/apps/codec_builtin_mp3.c b/apps/codec_builtin_mp3.c
new file mode 100644
index 0000000..f790bc7
--- /dev/null
+++ b/apps/codec_builtin_mp3.c
@@ -0,0 +1,211 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * Built-in MPEG-1/2/2.5 audio layer I/II/III decoder (minimp3) for targets
+ * too small for the loadable mpa codec (HAVE_BUILTIN_MINIMP3).
+ *
+ * The code lives in the core (on the demand-paged targets it pages in from
+ * flash like the rest of it). The per-frame scratch and the PCM output use
+ * the codec area (and the plugin buffer above it), which no loadable codec
+ * occupies while this one runs; the decoder state is in BUILTIN_MP3_STATE
+ * (target RAM section) when defined. minimp3 decodes in single precision
+ * floating point: this file is built for the FPU (see apps.make).
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#include "config.h"
+#include "system.h"
+#include "codecs.h"
+#include "dsp_core.h"
+#include "metadata.h"
+#include "string.h"
+
+extern struct codec_api ci;             /* apps/codecs.c */
+extern unsigned char codecbuf[];        /* linker script */
+
+#define MINIMP3_NO_SIMD
+#include "../lib/minimp3/minimp3.h"            /* types only: implementation below */
+
+/* codec area layout: [decoder state,] scratch, PCM output */
+#ifdef BUILTIN_MP3_STATE
+static mp3dec_t mp3_state __attribute__((section(BUILTIN_MP3_STATE)));
+#define MP3_DEC_ADDR      ((uintptr_t)&mp3_state)
+#define MP3_SCRATCH_ADDR  ((uintptr_t)codecbuf)
+#else
+#define MP3_DEC_ADDR      ((uintptr_t)codecbuf)
+#define MP3_SCRATCH_ADDR  (MP3_DEC_ADDR + ((sizeof(mp3dec_t) + 31) & ~31))
+#endif
+
+#define MINIMP3_IMPLEMENTATION
+#define MINIMP3_SCRATCH   MP3_SCRATCH_ADDR
+#include "../lib/minimp3/minimp3.h"
+
+#define MP3_PCM_ADDR \
+    (MP3_SCRATCH_ADDR + ((sizeof(mp3dec_scratch_t) + 31) & ~31))
+#define MP3_AREA_END \
+    (MP3_PCM_ADDR + MINIMP3_MAX_SAMPLES_PER_FRAME * sizeof(short))
+#ifdef BUILTIN_MP3_STATE
+#define MP3_AREA_START    MP3_SCRATCH_ADDR
+#else
+#define MP3_AREA_START    MP3_DEC_ADDR
+#endif
+
+/* the codec area plus the (unused while playing) plugin buffer below the
+ * reserved flags at its top */
+#define MP3_AREA_SIZE (CODEC_SIZE + PLUGIN_BUFFER_SIZE - 64)
+
+#define dec   ((mp3dec_t *)MP3_DEC_ADDR)
+#define pcm   ((short *)MP3_PCM_ADDR)
+
+/* more than the largest frame (1441 bytes; minimp3 keeps the layer III bit
+ * reservoir itself). Keep it small: the file buffer may be only a few
+ * KiB, and bufgetdata() waits until the whole request is buffered. */
+#define MP3_REQUEST 2048
+
+/* the scratch area is in use (target debug code that borrows the plugin
+ * buffer checks this) */
+volatile bool codec_builtin_mp3_active;
+/* longest wait between two decoded frames (ticks), and how many waits
+ * were 6 ticks or more (debug statistics; reset by whoever reads them) */
+volatile long codec_builtin_mp3_max_gap, codec_builtin_mp3_long_gaps;
+volatile long codec_builtin_mp3_frames, codec_builtin_mp3_last_tick;
+volatile long codec_builtin_mp3_max_gap_at;     /* tick the longest ended */
+
+static enum codec_status builtin_mp3_main(enum codec_entry_call_reason reason)
+{
+    codec_builtin_mp3_active = (reason == CODEC_LOAD);
+    return CODEC_OK;
+}
+
+/* byte offset of a time, from the average bitrate (no TOC on this path) */
+static off_t time_to_offset(unsigned long ms)
+{
+    struct mp3entry *id3 = ci.id3;
+    off_t pos = id3->first_frame_offset;
+    if (id3->bitrate)
+        pos += (off_t)((uint64_t)ms * id3->bitrate / 8);
+    return pos;
+}
+
+static enum codec_status builtin_mp3_run(void)
+{
+    mp3dec_frame_info_t info;
+    unsigned long samples_done = 0;
+    int freq = 0, channels = 0;
+    intptr_t param;
+
+    if (MP3_AREA_END - MP3_AREA_START > MP3_AREA_SIZE)
+        return CODEC_ERROR;     /* configuration error, see config */
+
+    memset(dec, 0, sizeof(*dec));
+    mp3dec_init(dec);
+
+    /* resume position or start of audio */
+    if (ci.id3->offset > ci.id3->first_frame_offset)
+    {
+        ci.seek_buffer(ci.id3->offset);
+        if (ci.id3->bitrate)
+            samples_done = (uint64_t)(ci.id3->offset - ci.id3->first_frame_offset)
+                           * 8 * ci.id3->frequency / ((uint64_t)ci.id3->bitrate * 1000);
+    }
+    else if (ci.id3->elapsed)
+    {
+        ci.seek_buffer(time_to_offset(ci.id3->elapsed));
+        samples_done = (uint64_t)ci.id3->elapsed * ci.id3->frequency / 1000;
+    }
+    else
+        ci.seek_buffer(ci.id3->first_frame_offset);
+
+    ci.configure(DSP_SET_SAMPLE_DEPTH, 16);
+
+    while (1)
+    {
+        long action = ci.get_command(&param);
+
+        if (action == CODEC_ACTION_HALT)
+            break;
+
+        if (action == CODEC_ACTION_SEEK_TIME)
+        {
+            unsigned long ms = param;
+            if (ms > ci.id3->length)
+                ms = ci.id3->length;
+            ci.seek_buffer(time_to_offset(ms));
+            mp3dec_init(dec);
+            samples_done = freq ? (uint64_t)ms * freq / 1000 : 0;
+            ci.set_elapsed(ms);
+            ci.seek_complete();
+            continue;
+        }
+
+        size_t n;
+        const uint8_t *buf = ci.request_buffer(&n, MP3_REQUEST);
+        if (n == 0 || buf == NULL)
+            break;                      /* end of the file */
+
+        int samples = mp3dec_decode_frame(dec, buf, n, pcm, &info);
+
+        if (info.frame_bytes == 0)
+        {
+            /* no frame in what we have: at the end of the file, done;
+             * otherwise skip the junk minimp3 looked at (keeping the last
+             * bytes: a header may start there) */
+            if (n < MP3_REQUEST || n <= 4)
+                break;                  /* bufgetdata clips only at EOF */
+            ci.advance_buffer(n - 4);
+            continue;
+        }
+        ci.advance_buffer(info.frame_bytes);
+
+        if (samples <= 0)
+            continue;                   /* reservoir warm-up or bad frame */
+
+        if (info.hz != freq || info.channels != channels)
+        {
+            freq = info.hz;
+            channels = info.channels;
+            ci.configure(DSP_SET_FREQUENCY, freq);
+            ci.configure(DSP_SET_STEREO_MODE,
+                         channels == 2 ? STEREO_INTERLEAVED : STEREO_MONO);
+        }
+
+        {
+            long now = current_tick;
+            long last = codec_builtin_mp3_last_tick, gap = now - last;
+            if (last && gap > codec_builtin_mp3_max_gap)
+            {
+                codec_builtin_mp3_max_gap = gap;
+                codec_builtin_mp3_max_gap_at = now;
+            }
+            if (last && gap >= 6)
+                codec_builtin_mp3_long_gaps++;
+            codec_builtin_mp3_last_tick = now;
+            codec_builtin_mp3_frames++;
+        }
+        ci.pcmbuf_insert(pcm, NULL, samples);
+        samples_done += samples;
+        ci.set_elapsed((uint64_t)samples_done * 1000 / freq);
+    }
+
+    return CODEC_OK;
+}
+
+static struct codec_api *builtin_mp3_api;
+
+const struct codec_header builtin_mp3_header = {
+    { CODEC_MAGIC, TARGET_ID, CODEC_API_VERSION, codecbuf, codecbuf },
+    builtin_mp3_main, builtin_mp3_run, &builtin_mp3_api,
+    sizeof(struct codec_api)
+};
