+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#include "config.h"
+
+    .syntax unified
+    .text
+
+    .section .vectors.platform,"ax",%progbits
+
+    .global __vectors_platform
+__vectors_platform:
+    .rept 2
+    .word   UIE
+    .endr
+    .word   timer_irq_handler           /* [  2] RTC timer T0 */
+    .rept 9
+    .word   UIE
+    .endr
+    .word   usb_irq_handler             /* [ 12] USB */
+    .rept 18
+    .word   UIE
+    .endr
+    .word   dma_irq_handler             /* [ 31] DMA controller */
+    .rept 10
+    .word   UIE
+    .endr
