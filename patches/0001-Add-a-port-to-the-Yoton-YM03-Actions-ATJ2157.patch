+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+/* Yoton YM03 misc: USB (not supported yet), ADC, I2C, hardware info */
+#include "system.h"
+#include "usb.h"
+#include "adc.h"
+#include "lcd.h"
+#include "font.h"
+#include "button.h"
+#ifndef BOOTLOADER
+#include "action.h"
+#endif
+#include <stdio.h>
+
+#ifndef HAVE_USBSTACK
+/* without the USB stack: report the cable as absent */
+void usb_init_device(void) {}
+int usb_detect(void) { return USB_EXTRACTED; }
+void usb_enable(bool on) { (void)on; }
+#endif
+
+void adc_init(void) {}
+
+unsigned short adc_read(int channel)
+{
+    switch (channel)
+    {
+    case ADC_BATTERY: return PMU_BATADC & 0x3ff;
+    case ADC_KEYS:    return PMU_LRADC(1) & 0x3ff;
+    default:          return 0;
+    }
+}
+
+/* no I2C peripherals are used (no FM tuner on this model) */
+void i2c_init(void) {}
+
+#ifndef BOOTLOADER
+bool dbg_hw_info(void)
+{
+    char buf[32];
+    lcd_setfont(FONT_SYSFIXED);
+    while (1)
+    {
+        lcd_clear_display();
+        int y = 0;
+        lcd_putsf(0, y++, "ATJ2157 / Yoton YM03");
+        lcd_putsf(0, y++, "CMU %08lx", (unsigned long)CMU_SYSCLK);
+        lcd_putsf(0, y++, "CLK %08lx", (unsigned long)CMU_CLKEN0);
+        lcd_putsf(0, y++, "BAT %03lx KEY %03lx",
+                  (unsigned long)(PMU_BATADC & 0x3ff),
+                  (unsigned long)(PMU_LRADC(1) & 0x3ff));
+        snprintf(buf, sizeof(buf), "GPIO %08lx", (unsigned long)GPIO_IN(0));
+        lcd_puts(0, y++, buf);
+        lcd_update();
+        if (action_userabort(HZ / 10))
+            break;
+    }
+    lcd_setfont(FONT_UI);
+    return false;
+}
+#endif
diff --git a/firmware/target/arm/atj2157/yotonym03/pcm-yotonym03.c b/firmware/target/arm/atj2157/yotonym03/pcm-yotonym03.c
new file mode 100644
index 0000000..8e141b5
--- /dev/null
+++ b/firmware/target/arm/atj2157/yotonym03/pcm-yotonym03.c
@@ -0,0 +1,268 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * PCM output for the Yoton YM03 through the ATJ2157 internal DAC.
+ *
+ * Bring-up sequence recovered from the vendor AUD_DEV.DRV and verified on
+ * hardware: analog power + audio PLL, DAC clock in CMU+0x88, DAC/PA reset,
+ * the vendor's pop-free PA power-up, then DMA channel 5 streaming 16-bit
+ * stereo frames into the DAC FIFO (mode 0x148b00 expands them to the
+ * 32-bit-per-channel FIFO format). DMA completion is NVIC line 31.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#include "system.h"
+#include "kernel.h"
+#include "audio.h"
+#include "audiohw.h"
+#include "pcm.h"
+#include "pcm-internal.h"
+#include "pcm_sink.h"
+#include "pcm_sampr.h"
+
+#define DAC(x)          ATJ_REG(0xc0180000 + (x))
+#define DAC_DMA_CH      5
+#define DAC_DMA_MODE    0x00148b00          /* 16-bit stereo -> DAC FIFO */
+#define DMA_IRQ         31
+#define NVIC_ISER0      ATJ_REG(0xe000e100)
+#define NVIC_ICER0      ATJ_REG(0xe000e180)
+#define DAC_VOLUME      0xc0                /* fixed analog level; Rockbox
+                                               does software volume */
+
+static int play_lock;
+void dma_irq_handler(void);
+
+/* playback statistics, shown by the host test mode (apps/main.c) */
+volatile unsigned long ym03_pcm_irqs, ym03_pcm_bytes, ym03_pcm_starts;
+
+/* --- low-level DAC ------------------------------------------------------- */
+
+static void fifo_put(uint32_t v, int stereo)
+{
+    for (int t = 0; t < 20000 && !(DAC(8) & 0x80); t++);
+    DAC(0x0c) = v;
+    if (stereo)
+        DAC(0x0c) = v;
+    DAC(8) = 0x80;
+}
+
+static void fifo_fill(uint32_t v, int n, int stereo)
+{
+    while (n--)
+        fifo_put(v, stereo);
+}
+
+/* clock for a sample rate in Hz (vendor 0x1864): base 176.4/192 kHz family,
+ * divider from {1,2,3,4,6,8,12,24} with an extra /2 for 16 and 24 */
+static void dac_set_rate(unsigned long rate)
+{
+    static const unsigned char divs[8] = { 1, 2, 3, 4, 6, 8, 12, 24 };
+    bool fam44 = (rate % 11025) == 0;
+    unsigned div = fam44 ? 176400 / rate : 192000 / rate;
+    unsigned half = 0, idx = 3;
+
+    if (div == 16 || div == 24)
+    {
+        div /= 2;
+        half = 1;
+    }
+    for (unsigned i = 0; i < 8; i++)
+        if (divs[i] == div)
+            idx = i;
+
+    CMU_DACCLK = (CMU_DACCLK & ~0xd7u) | 0x400 |
+                 (fam44 ? (1u << 6) : 0) | (half << 4) | idx;
+}
+
+static void dac_power_up(void)
+{
+    /* analog power and audio PLL (vendor bank 0x800) */
+    ATJ_REG(0xc0010018) = (ATJ_REG(0xc0010018) | 0x40) & ~0x20u;
+    ATJ_REG(0xc0000118) = (ATJ_REG(0xc0000118) & ~0x1fu) | 0x1c;
+    ATJ_REG(0xc000011c) = (ATJ_REG(0xc000011c) & ~0x1fu) | 0x14;
+    mdelay(5);
+
+    /* CLKEN1 bit 11 and the codec/ADC clock (CMU+0x80) are needed for any
+     * analog output (found by bisecting the audible test payloads) */
+    CMU_CLKEN1 |= 1 | 4 | 0x800;
+    CMU_ADCCLK = 0x33000000 | (1 << 6) | 3;
+    dac_set_rate(44100);
+    RMU_RST1 &= ~5u;
+    udelay(10);
+    RMU_RST1 |= 1 | 4;
+
+    /* vendor pop-free PA power-up (bank 0x4000) */
+    uint32_t mid = 0x7fffffff, step = 0xffffffffu / 4800, v = 0x7fffffff;
+    DAC(0x28) |= 0x80;
+    DAC(0x28) &= ~0x300u;
+    DAC(0) |= 1; DAC(0) |= 0x100; DAC(0) |= 0x10; DAC(0) |= 2;
+    DAC(0x28) |= 3; DAC(0x28) |= 0x14; DAC(0x28) |= 0x40;
+    DAC(4) = 0;
+    DAC(4) = (DAC(4) | 1) & ~0x36u;
+    fifo_fill(mid, 192, 0);
+    DAC(0x2c) |= 0x101; DAC(0x2c) |= 0x1010;
+    fifo_fill(mid, 192, 0);
+    DAC(0x2c) |= 0x202; DAC(0x2c) |= 0x404;
+    for (int n = 4800; n > 0; n--) { fifo_put(v, 1); v -= step; }
+    v += step;
+    fifo_fill(v, 192, 0);
+    DAC(0x2c) |= 0x808;
+    fifo_fill(v, 192, 0);
+    DAC(0x28) |= 0x28;
+    fifo_fill(v, 192, 0);
+    DAC(0x2c) &= ~0x1010u;
+    for (int n = 4800; n > 0; n--) { fifo_put(v, 1); v += step; }
+    v -= step;
+    fifo_fill(v, 192, 0);
+    DAC(0x2c) &= ~0x202u; DAC(0x2c) &= ~0x404u;
+    fifo_fill(0, 192, 0);
+    DAC(0x2c) &= ~0x101u;
+    DAC(0x28) = (DAC(0x28) & ~0x30000u) | 0x10000;
+    DAC(0x28) |= 0x40000;
+    DAC(0x28) |= 0x300;
+
+    /* volume, unmuted */
+    DAC(0x14) = (DAC(0x14) & ~0xff8ffu) | 0x33700 | DAC_VOLUME;
+    DAC(0x18) = (DAC(0x18) & ~0xff8ffu) | 0x33700 | DAC_VOLUME;
+
+    /* FIFO fed by DMA from now on (vendor 0x195c) */
+    DAC(4) &= ~0x11u;
+    DAC(4) |= 1;
+    DAC(4) |= 0x12;
+}
+
+/* --- PCM sink ------------------------------------------------------------ */
+
+static void dma_start(const void *addr, size_t size)
+{
+    DMA_CTL(DAC_DMA_CH) = 0;
+    DMA_IRQPD = (1 << DAC_DMA_CH) | (1 << (DAC_DMA_CH + 16));
+    DMA_MODE(DAC_DMA_CH) = DAC_DMA_MODE;
+    DMA_SRC(DAC_DMA_CH) = atj_dma_addr(addr);
+    DMA_DST(DAC_DMA_CH) = 0xc018000c;
+    DMA_LEN(DAC_DMA_CH) = size;
+    ym03_pcm_bytes += size;
+    DMA_CTL(DAC_DMA_CH) = 1;
+}
+
+/* refill the DAC DMA from inside a page fault (see pager_poll_hook); only
+ * when the DMA interrupt is enabled, i.e. not inside a pcm lock */
+static void pcm_pager_poll(void)
+{
+    if (!(NVIC_ISER0 & (1u << DMA_IRQ)))
+        return;
+    if (DMA_IRQPD & (1 << DAC_DMA_CH))
+    {
+        dma_irq_handler();
+        ATJ_REG(0xe000e280) = 1u << DMA_IRQ;   /* handled: drop the pending IRQ */
+    }
+}
+
+static void sink_init(void)
+{
+    extern void (*pager_poll_hook)(void);
+    pager_poll_hook = pcm_pager_poll;
+    dac_power_up();
+    DMA_IRQEN |= 1 << DAC_DMA_CH;
+    NVIC_ISER0 = 1u << DMA_IRQ;
+}
+
+static void sink_postinit(void)
+{
+}
+
+static void sink_set_freq(uint16_t freq)
+{
+    dac_set_rate(hw_freq_sampr[freq]);
+}
+
+static void sink_lock(void)
+{
+    if (play_lock++ == 0)
+        NVIC_ICER0 = 1u << DMA_IRQ;
+}
+
+static void sink_unlock(void)
+{
+    if (--play_lock == 0)
+        NVIC_ISER0 = 1u << DMA_IRQ;
+}
+
+static void sink_play(const void *addr, size_t size)
+{
+    ym03_pcm_starts++;
+    dma_start(addr, size);
+    pcm_play_dma_status_callback(PCM_DMAST_STARTED);
+}
+
+static void sink_stop(void)
+{
+    DMA_CTL(DAC_DMA_CH) = 0;
+    DMA_IRQPD = (1 << DAC_DMA_CH) | (1 << (DAC_DMA_CH + 16));
+}
+
+struct pcm_sink builtin_pcm_sink = {
+    .caps = {
+        .samprs       = hw_freq_sampr,
+        .num_samprs   = HW_NUM_FREQ,
+        .default_freq = HW_FREQ_DEFAULT,
+        .volume_type  = PCM_NATIVE_VOLUME_TYPE,
+    },
+    .ops = {
+        .init     = sink_init,
+        .postinit = sink_postinit,
+        .set_freq = sink_set_freq,
+        .lock     = sink_lock,
+        .unlock   = sink_unlock,
+        .play     = sink_play,
+        .stop     = sink_stop,
+    },
+};
+
+/* DMA controller interrupt (NVIC 31): chain the next PCM buffer */
+void dma_irq_handler(void)
+{
+    uint32_t pd = DMA_IRQPD;
+
+    if (pd & (1 << DAC_DMA_CH))
+    {
+        const void *addr;
+        size_t size;
+        {
+            /* test-mode statistics: DMA refill gaps (should be ~5.8 ms) */
+            static uint32_t last;
+            uint32_t now = USEC_TIMER;
+            uint32_t gap = now - last;
+            volatile uint32_t *st = (volatile uint32_t *)0x137fd0;
+            if (last && gap > st[0])
+                st[0] = gap;
+            if (last && gap > 8000)
+                st[1]++;
+            if (last && gap > 20000)
+                st[2]++;
+            last = now;
+        }
+
+        DMA_IRQPD = (1 << DAC_DMA_CH) | (1 << (DAC_DMA_CH + 16));
+        ym03_pcm_irqs++;
+        if (pcm_play_dma_complete_callback(PCM_DMAST_OK, &addr, &size))
+        {
+            dma_start(addr, size);
+            pcm_play_dma_status_callback(PCM_DMAST_STARTED);
+        }
+    }
+    /* clear anything else we don't own so the line deasserts */
+    DMA_IRQPD = pd & ~((1u << DAC_DMA_CH) | (1u << (DAC_DMA_CH + 16)));
+}
