+                    lcd_set_drawmode(DRMODE_SOLID);
+                    lcd_putsf(0, 0, "st %x el %lu/%lu", audio_status(),
+                              id3 ? id3->elapsed : 0, id3 ? id3->length : 0);
+                    lcd_putsf(0, 1, "irq %lu st %lu", ym03_pcm_irqs, ym03_pcm_starts);
+                    extern volatile long ym03_pb_calls[4];
+                    lcd_putsf(0, 7, "ld %ld fin %ld rb %ld lo %ld", ym03_pb_calls[0],
+                              ym03_pb_calls[1], ym03_pb_calls[2], ym03_pb_calls[3]);
+                    lcd_putsf(0, 2, "kB %lu play %ld.%02lds", ym03_pcm_bytes / 1024,
+                              (t_end - t_start) / HZ, (t_end - t_start) % HZ);
+                    lcd_putsf(0, 3, "dac %lu el@5s %lu",
+                              tk7 > tk2 ? (b7 - b2) * HZ / (tk7 - tk2) : 0, el5);
+                    {
+                        static char al[160];
+                        core_dump_short(al, sizeof(al));
+                        for (int k = 0; k < 4 && al[k * 21]; k++)
+                        {
+                            char line[22];
+                            strlcpy(line, al + k * 21, sizeof(line));
+                            lcd_puts(0, 4 + k, line);
+                        }
+                    }
+                    {
+                        /* page faults: count, average and worst read time
+                         * (us at 48 MHz), SPI clock, DMA used */
+                        extern uint32_t pager_cyc_total, pager_cyc_max, pager_cyc_n;
+                        extern bool pager_dma_used;
+                        lcd_putsf(0, 6, "pf %lu %lu/%luus %x%c", pager_cyc_n,
+                                  pager_cyc_n ? pager_cyc_total / pager_cyc_n / 48 : 0,
+                                  pager_cyc_max / 48,
+                                  (unsigned)(*(volatile uint32_t *)0xc0001020 & 0x3ff),
+                                  pager_dma_used ? 'D' : 'P');
+                    }
+                    int y = 10;
+                    for (unsigned int t = 0; t < MAXTHREADS && y < 8; t++)
+                    {
+                        struct thread_debug_info info;
+                        if (thread_get_debug_info(t, &info) <= 0)
+                            continue;
+                        lcd_putsf(0, y++, "%.10s %u%%", info.name,
+                                  info.stack_usage);
+                    }
+                    lcd_update();
+                    /* hand the fault profile to the host: it reads the
+                     * framebuffer after the reboot. Rows 64.. hold
+                     * "YPRF", count, then 512 x {addr, lr}. */
+#ifdef YM03_PAGER_PROFILE
+                    uint32_t *fb = (uint32_t *)0x15e000; /* (unused) */
+                    fb[0] = 0x46525059;
+                    fb[1] = pager_profile_n;
+                    memcpy(&fb[2], pager_profile, sizeof(pager_profile));
+#endif
+                    while (1)
+                        sleep(HZ);      /* keep this frame for the capture */
+                }
+                sleep(HZ / 10);
+            }
+        }
+    }
+#endif
     CHART(">root_menu");
     root_menu();
 }
