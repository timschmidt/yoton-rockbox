diff --git a/firmware/target/arm/atj2157/app.lds b/firmware/target/arm/atj2157/app.lds
new file mode 100644
index 0000000..1deef1a
--- /dev/null
+++ b/firmware/target/arm/atj2157/app.lds
@@ -0,0 +1,115 @@
+#include "cpu.h"
+
+/*
+ * Main firmware layout for the ATJ2157 (320 KiB of SRAM, no XIP).
+ *
+ * The firmware is demand-paged: tools/ym03_pagelink.py links it twice.
+ * Pass 1 uses a huge resident region to measure every input section
+ * (-ffunction-sections/-fdata-sections). Pass 2 moves the non-resident
+ * sections into 8 KiB pages linked at aliases of SRAM2 (see
+ * pager-atj2157.c) via the generated ym03_pages.lds. Page sections are
+ * (COPY) sections: linked and relocated, but not part of the loaded image;
+ * the tool extracts them into the page store written to NOR.
+ *
+ * Resident image: loaded flat at 0x100000 by the bootloader.
+ */
+ENTRY(reset_handler)
+OUTPUT_FORMAT(elf32-littlearm)
+OUTPUT_ARCH(arm)
+STARTUP(target/arm/atj2157/crt0-atj2157.o)
+
+INCLUDE ym03_layout.lds
+
+MEMORY
+{
+    SRAM0  (rwx) : ORIGIN = YM03_SRAM0_ORG, LENGTH = YM03_SRAM0_LEN
+    SRAM1  (rw)  : ORIGIN = ATJ_SRAM1_BASE, LENGTH = ATJ_SRAM1_SIZE
+    SRAM3  (rw)  : ORIGIN = ATJ_SRAM3_BASE + 0x4000, LENGTH = 0x4000  /* slots 0-1: rodata page cache */
+}
+
+SECTIONS
+{
+    INCLUDE ym03_pages.lds
+
+    .text :
+    {
+        _loadaddress = .;
+        loadaddress = .;
+        *(.init*);
+        . = ALIGN(256);
+        KEEP(*(.vectors.arm));
+        KEEP(*(.vectors.platform));
+        *(.icode*);
+        *(.text*);
+        *(.irodata*);
+        *(.rodata*);
+        . = ALIGN(4);
+        *(.idata*);
+        *(.data*);
+        . = ALIGN(4);
+        _imageend = .;
+    } > SRAM0
+
+    /* thread stacks placed in the free half of SRAM3 (not zeroed) */
+    .bss3 (NOLOAD) :
+    {
+        *codec_thread.o(.bss.codec_stack)
+        *audio_thread.o(.bss.audio_stack)
+        *buffering.o(.bss.buffering_stack)
+        *voice_thread.o(.bss.voice_stack)
+        *libfirmware.a:storage.o(.bss.storage_thread_stack)
+        *(.sram3*);
+        /* exception stack (MSP); crt0 enables SRAM3 before using it.
+         * 0.25 KiB used at most (measured) */
+        . = ALIGN(8);
+        irqstackbegin = .;
+        . += 0x400;
+        irqstackend = .;
+        /* 0x307c00-0x307fff stays free: host test results (maintest) */
+        ASSERT(. <= 0x307c00, "SRAM3 stacks overlap the host test area");
+    } > SRAM3
+
+    .bss (NOLOAD) :
+    {
+        _bssbegin = .;
+        *(.ibss*);
+        *(.bss*);
+        *(COMMON);
+        . = ALIGN(4);
+        _bssend = .;
+    } > SRAM0
+
+    .stack (NOLOAD) : ALIGN(8)
+    {
+        stackbegin = .;
+        . += 0x1800;
+        stackend = .;
+    } > SRAM0
+
+    /* everything left in SRAM0 up to the codec/plugin buffers is audio buffer */
+    .audiobuf (NOLOAD) : ALIGN(32)
+    {
+        audiobuffer = .;
+    } > SRAM0
+    audiobufend = ORIGIN(SRAM0) + LENGTH(SRAM0) - CODEC_SIZE - PLUGIN_BUFFER_SIZE;
+    codecbuf = audiobufend;
+    pluginbuf = codecbuf + CODEC_SIZE;
+
+    .framebuffer (NOLOAD) :
+    {
+        *(.framebuffer);
+    } > SRAM1
+
+    .bss2 (NOLOAD) :
+    {
+        _bss2begin = .;
+        _bss2end = .;
+    } > SRAM0
+
+}
+
+EXTERN(__vectors_arm);
+EXTERN(__vectors_platform);
+ASSERT(DEFINED(__vectors_arm), "ARM exception vectors are not defined.");
+ASSERT(DEFINED(__vectors_platform), "Platform exception vectors are not defined.");
+ASSERT(audiobuffer <= audiobufend, "SRAM0 overflow: no room for audio buffer");
diff --git a/firmware/target/arm/atj2157/boot.lds b/firmware/target/arm/atj2157/boot.lds
new file mode 100644
index 0000000..3729f3e
--- /dev/null
+++ b/firmware/target/arm/atj2157/boot.lds
@@ -0,0 +1,82 @@
+#include "cpu.h"
+
+/*
+ * Bootloader layout. The image is a flat binary loaded at its link
+ * address, so .data needs no copy. It lives in the top 80 KiB of SRAM0,
+ * which keeps 0x100000-0x123fff free for the firmware it loads and keeps
+ * clear of the development monitor (0x118000-0x11ffff) while loading.
+ */
+ENTRY(reset_handler)
+OUTPUT_FORMAT(elf32-littlearm)
+OUTPUT_ARCH(arm)
+STARTUP(target/arm/atj2157/crt0-atj2157.o)
+
+MEMORY
+{
+    SRAM0B (rwx) : ORIGIN = 0x00124000, LENGTH = 0x00014000
+    SRAM1  (rw)  : ORIGIN = ATJ_SRAM1_BASE, LENGTH = ATJ_SRAM1_SIZE
+    SRAM2  (rw)  : ORIGIN = ATJ_SRAM2_BASE, LENGTH = ATJ_SRAM2_SIZE
+    SRAM3  (rw)  : ORIGIN = ATJ_SRAM3_BASE, LENGTH = ATJ_SRAM3_SIZE
+}
+
+SECTIONS
+{
+    .text :
+    {
+        _loadaddress = .;
+        *(.init*);
+        . = ALIGN(256);
+        KEEP(*(.vectors.arm));
+        KEEP(*(.vectors.platform));
+        *(.text*);
+        *(.rodata*);
+        . = ALIGN(4);
+        *(.data*);
+        . = ALIGN(4);
+        _imageend = .;
+    } > SRAM0B
+
+    .bss (NOLOAD) :
+    {
+        _bssbegin = .;
+        *(.bss*);
+        *(COMMON);
+        . = ALIGN(4);
+        _bssend = .;
+    } > SRAM0B
+
+    .stack (NOLOAD) : ALIGN(8)
+    {
+        irqstackbegin = .;
+        . += 0x600;
+        irqstackend = .;
+
+        stackbegin = .;
+        . += 0x1800;
+        stackend = .;
+    } > SRAM0B
+
+    .framebuffer (NOLOAD) :
+    {
+        *(.framebuffer);
+    } > SRAM1
+
+    /* large buffers explicitly placed in the spare SRAM blocks */
+    .bss2 (NOLOAD) :
+    {
+        _bss2begin = .;
+        *(.sram2*);
+        . = ALIGN(4);
+        _bss2end = .;
+    } > SRAM2
+
+    .bss3 (NOLOAD) :
+    {
+        *(.sram3*);
+    } > SRAM3
+}
+
+EXTERN(__vectors_arm);
+EXTERN(__vectors_platform);
+ASSERT(DEFINED(__vectors_arm), "ARM exception vectors are not defined.");
+ASSERT(DEFINED(__vectors_platform), "Platform exception vectors are not defined.");
diff --git a/firmware/target/arm/atj2157/crt0-atj2157.S b/firmware/target/arm/atj2157/crt0-atj2157.S
new file mode 100644
index 0000000..a47d9ae
--- /dev/null
+++ b/firmware/target/arm/atj2157/crt0-atj2157.S
@@ -0,0 +1,163 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * ATJ2157 startup code.
+ *
+ * The image is entered at its load address (the first word of .init) by
+ * whatever loaded it: the boot-ROM ADFU/ymon monitor during development or
+ * the NOR boot stub. Interrupts may be enabled and VTOR may point anywhere,
+ * so take over the machine state before touching memory.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#include "config.h"
+
+    .syntax unified
+    .thumb
+    .text
+
+    .section .init,"ax",%progbits
+
+    .global reset_handler
+    .type reset_handler, function
+reset_handler:
+    cpsid   i
+
+    /* Disable all NVIC interrupts left enabled by the loader */
+    ldr     r0, =0xe000e180             @ NVIC_ICER0
+    mvn     r1, #0
+    str     r1, [r0]
+    str     r1, [r0, #4]
+
+    /* Stop SysTick */
+    ldr     r0, =0xe000e010
+    movs    r1, #0
+    str     r1, [r0]
+
+    /* Point VTOR at our vector table */
+    ldr     r0, =0xe000ed08
+    ldr     r1, =__vectors_arm
+    str     r1, [r0]
+    dsb
+    isb
+
+    /*
+     * SRAM2/SRAM3 bring-up, as the stock firmware's second boot stage does
+     * it (NOR sector 0, descrambled offset 0x54a): clocks (CMU_CLKEN0 bits
+     * 9/10), reset pulse (RMU_RST0 bits 9/10), then the address windows
+     * 0x200000-0x207fff / 0x300000-0x307fff. After a cold NOR boot they are
+     * off - our page slots and the SRAM3 stacks live there. Only the boot
+     * ROM's USB recovery mode had left them on.
+     */
+    ldr     r0, =0xc0001000
+    ldr     r1, [r0, #8]
+    orr     r1, r1, #0x600
+    str     r1, [r0, #8]
+    ldr     r0, =0xc0000000
+    ldr     r1, [r0]
+    bic     r1, r1, #0x600
+    str     r1, [r0]
+    orr     r1, r1, #0x600
+    str     r1, [r0]
+    ldr     r0, =0xc0040000
+    ldr     r1, =0x00200000
+    str     r1, [r0, #0x10]
+    ldr     r1, =0x00207fff
+    str     r1, [r0, #0x14]
+    ldr     r1, =0x00300000
+    str     r1, [r0, #0x18]
+    ldr     r1, =0x00307fff
+    str     r1, [r0, #0x1c]
+    ldr     r0, =0xc0040300
+    ldr     r1, =0x00200000
+    str     r1, [r0, #0x00]
+    movs    r1, #0
+    str     r1, [r0, #0x04]
+    ldr     r1, =0x00300000
+    str     r1, [r0, #0x08]
+    movs    r1, #0
+    str     r1, [r0, #0x0c]
+    dsb
+    isb
+    /* Use the IRQ stack on MSP before calling anything */
+    ldr     r0, =irqstackend
+    msr     msp, r0
+    movs    r0, #0
+    msr     control, r0
+    isb
+
+    /* Zero out BSS */
+    ldr     a1, =_bssbegin
+    ldr     a2, =_bssend
+    mov     a3, #0
+    bl      crt0_area_clear
+
+    /* Zero out the extra SRAM-block BSS */
+    ldr     a1, =_bss2begin
+    ldr     a2, =_bss2end
+    mov     a3, #0
+    bl      crt0_area_clear
+
+    /* Clear the main thread stack */
+    ldr     a1, =stackbegin
+    ldr     a2, =stackend
+    ldr     a3, =0xdeadbeef
+    bl      crt0_area_clear
+
+    /* Clear the IRQ stack (we are using its top; leave 64 bytes) */
+    ldr     a1, =irqstackbegin
+    ldr     a2, =irqstackend
+    sub     a2, a2, #64
+    ldr     a3, =0xdeadbeef
+    bl      crt0_area_clear
+
+    /* Enable MemManage, BusFault and UsageFault exceptions */
+    ldr     r0, =0xe000ed24             @ SHCSR
+    ldr     r1, [r0]
+    orr     r1, r1, #0x70000
+    str     r1, [r0]
+
+    /*
+     * Interrupt masking uses BASEPRI (see system-arm-micro.h): start with
+     * BASEPRI at the "disabled" level and PRIMASK clear.
+     */
+    movs    r0, #0x80
+    msr     basepri, r0
+    cpsie   i
+
+#ifndef BOOTLOADER
+    /* The page store must be online before any paged code runs */
+    bl      atj_pager_early_init
+#endif
+
+    /* Use PSP for thread code */
+    ldr     r0, =stackend
+    msr     psp, r0
+    mrs     r2, control
+    orr     r2, #2
+    msr     control, r2
+    isb
+
+    b       main
+
+    .local crt0_area_clear
+    .type crt0_area_clear, function
+/* crt0_area_clear(uint32_t *dst, uint32_t *end, uint32_t value) */
+crt0_area_clear:
+    cmp     a2, a1
+    itt     hi
+    strhi   a3, [a1], #4
+    bhi     crt0_area_clear
+    bx      lr
