+ ****************************************************************************/
+/* Yoton YM03 power: PMU power-off, battery ADC */
+#include "system.h"
+#include "power.h"
+#include "powermgmt.h"
+
+/*
+ * Battery levels in mV. The BATADC scale is not calibrated yet: the vendor
+ * KEY.DRV treats raw 885 as "full" and 640 as "empty"; a fresh unit reads
+ * about 892. Assume 4.2 V at 900 until measured.
+ */
+unsigned short battery_level_disksafe = 3400;
+unsigned short battery_level_shutoff = 3300;
+unsigned short percent_to_volt_discharge[11] =
+    { 3400, 3550, 3650, 3700, 3740, 3780, 3830, 3890, 3960, 4050, 4150 };
+unsigned short percent_to_volt_charge[11] =
+    { 3500, 3650, 3750, 3800, 3840, 3880, 3930, 3990, 4060, 4150, 4200 };
+
+int _battery_voltage(void)
+{
+    return (PMU_BATADC & 0x3ff) * 4200 / 900;
+}
+
+void power_init(void)
+{
+}
+
+bool charging_state(void)
+{
+    return false;
+}
+
+unsigned int power_input_status(void)
+{
+    return POWER_INPUT_NONE;
+}
+
+void power_off(void)
+{
+    /* sequence used by the boot ROM ADFU server to switch the PMU off */
+    disable_irq();
+    while (PMU_STAT & (1u << 30));
+    PMU_CTL0 &= ~2;
+    udelay(5000);
+    PMU_CTL0 &= ~1;
+    while (1);
+}
diff --git a/firmware/target/arm/atj2157/yotonym03/sdmmc-yotonym03.c b/firmware/target/arm/atj2157/yotonym03/sdmmc-yotonym03.c
new file mode 100644
index 0000000..eaa452d
--- /dev/null
+++ b/firmware/target/arm/atj2157/yotonym03/sdmmc-yotonym03.c
@@ -0,0 +1,319 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+/*
+ * ATJ2157 SD0 host controller driver for the generic sdmmc_host layer.
+ * Register behaviour recovered from the mask ROM and vendor CARD.DRV and
+ * verified on a Yoton YM03 (4-bit bus, SDHC/SDXC card, DMA channel 4).
+ */
+#include "system.h"
+#include "kernel.h"
+#include "sdmmc_host.h"
+#include "storage.h"
+
+#define SD_DMA_CH       4
+#define SD_TIMEOUT      (HZ / 2)
+
+static struct sdmmc_host sd_host;
+
+/* CMU_SD0CLK data-transfer setting: 3 = 6 MHz (first bring-up) */
+#ifndef YM03_SDCLK_FAST
+#define YM03_SDCLK_FAST 0
+#endif
+
+/* debug trace of recent commands: (cmd<<24 | flags<<8 | result&0xff, state) */
+uint32_t ym03_sd_trace[16][2];
+unsigned ym03_sd_trace_pos;
+static void sd_trace(uint32_t a, uint32_t b)
+{
+    unsigned i = ym03_sd_trace_pos++ & 15;
+    ym03_sd_trace[i][0] = a;
+    ym03_sd_trace[i][1] = b;
+}
+
+static void sd_pins_init(void)
+{
+    MFP_CTL(30) = 0x804 | MFP_DRIVE(5);     /* CLK */
+    MFP_CTL(32) = 0x804 | MFP_DRIVE(3);     /* CMD */
+    MFP_CTL(33) = 0x804 | MFP_DRIVE(3);     /* D0 */
+    MFP_CTL(29) = 0x804 | MFP_DRIVE(3);     /* D1 */
+    MFP_CTL(28) = 0x804 | MFP_DRIVE(3);     /* D2 */
+    MFP_CTL(27) = 0x804 | MFP_DRIVE(3);     /* D3 */
+}
+
+static int sd_wait_ctl(void)
+{
+    long end = current_tick + SD_TIMEOUT;
+    while (SD_CTL & SD_CTL_START)
+    {
+        if (TIME_AFTER(current_tick, end))
+            return -1;
+    }
+    return 0;
+}
+
+static void sd_set_power_enabled(void *controller, bool enable)
+{
+    (void)controller;
+    if (!enable)
+        return;
+
+    atj_module_enable(CLKEN0_SD0, CLKEN0_SD0 | CLKEN0_BIT0);
+    sd_pins_init();
+    CMU_SD0CLK = 0x41;
+    SD_EN = 0xc0;               /* 1-bit bus until told otherwise */
+
+    /* 74+ initialisation clocks */
+    SD_CTL = 0x001f00e8;
+    sd_wait_ctl();
+}
+
+static void sd_set_bus_width(void *controller, uint32_t width)
+{
+    (void)controller;
+    SD_EN = (SD_EN & ~3) | (width == SDMMC_BUS_WIDTH_4BIT ? 1 : 0);
+}
+
+static void sd_set_bus_clock(void *controller, uint32_t clock)
+{
+    (void)controller;
+    /* 0x41: identification rate (~400 kHz), 3: fast rate */
+    CMU_SD0CLK = (clock == SDMMC_BUS_CLOCK_400KHZ) ? 0x41 : YM03_SDCLK_FAST;
+}
+
+static int sd_submit_command_raw(void *controller,
+                             const struct sdmmc_host_command *cmd,
+                             struct sdmmc_host_response *resp)
+{
+    (void)controller;
+    uint32_t type;
+    bool data = SDMMC_DATA_PRESENT(cmd->flags);
+    bool write = SDMMC_DATA_DIR(cmd->flags) == SDMMC_DATA_WRITE;
+    uint32_t len = cmd->nr_blocks * cmd->block_len;
+
+    switch (SDMMC_RESP_LENGTH(cmd->flags))
+    {
+    case SDMMC_RESP_NONE:
+        type = SD_TYPE_NONE;
+        break;
+    case SDMMC_RESP_LONG:
+        type = SD_TYPE_R2;
+        break;
+    default:
+        type = (cmd->flags & (SDMMC_RESP_NOCRC | SDMMC_RESP_BUSY))
+               ? SD_TYPE_R3 : SD_TYPE_R1;
+        break;
+    }
+
+    SD_ARG = cmd->argument;
+    SD_CMD = cmd->command;
+
+    if (data)
+    {
+        SD_EN |= 0x40;
+        DMA_IRQPD = (1 << SD_DMA_CH) | (1 << (SD_DMA_CH + 16));
+        if (write)
+        {
+            DMA_MODE(SD_DMA_CH) = DMA_MODE_SD0_WRITE;
+            DMA_SRC(SD_DMA_CH) = atj_dma_addr(cmd->buffer);
+            DMA_DST(SD_DMA_CH) = SD_DAT;
+        }
+        else
+        {
+            DMA_MODE(SD_DMA_CH) = DMA_MODE_SD0_READ;
+            DMA_SRC(SD_DMA_CH) = SD_DAT;
+            DMA_DST(SD_DMA_CH) = atj_dma_addr(cmd->buffer);
+        }
+        DMA_LEN(SD_DMA_CH) = len;
+        SD_BLKSZ = cmd->block_len;
+        SD_BLKNUM = cmd->nr_blocks;
+        SD_CTL = SD_CTL_DATA | SD_CTL_TIMING |
+                 (write ? SD_TYPE_WDATA : SD_TYPE_RDATA);
+        DMA_CTL(SD_DMA_CH) |= 1;
+        SD_CTL |= SD_CTL_START;
+    }
+    else
+    {
+        SD_CTL = SD_CTL_TIMING | type | SD_CTL_START;
+    }
+
+    if (sd_wait_ctl())
+    {
+        DMA_CTL(SD_DMA_CH) = 0;
+        return SDMMC_STATUS_TIMEOUT;
+    }
+
+    uint32_t state = SD_STATE;
+
+    if (data)
+    {
+        long end = current_tick + SD_TIMEOUT;
+        while (DMA_CTL(SD_DMA_CH) & 1)
+        {
+            if (TIME_AFTER(current_tick, end))
+            {
+                DMA_CTL(SD_DMA_CH) = 0;
+                return SDMMC_STATUS_TIMEOUT;
+            }
+        }
+    }
+
+    /*
+     * Error bits: 0x8000 timeout, 0x01 response CRC, 0x02/0x10 data CRC,
+     * 0x04 other. R3 (OCR) carries no CRC, so the controller always flags
+     * a response CRC error for it: ignore those for no-CRC responses.
+     */
+    uint32_t errmask = SD_STATE_ERRMASK;
+    if (cmd->flags & SDMMC_RESP_NOCRC)
+        errmask &= ~0x11u;
+    if (state & errmask)
+    {
+        if (state & 0x8000)
+            return SDMMC_STATUS_TIMEOUT;
+        if (state & 0x0013)
+            return SDMMC_STATUS_INVALID_CRC;
+        return SDMMC_STATUS_ERROR;
+    }
+
+    if (resp)
+    {
+        if (type == SD_TYPE_R2)
+        {
+            resp->data[0] = SD_RSPBUF(3);
+            resp->data[1] = SD_RSPBUF(2);
+            resp->data[2] = SD_RSPBUF(1);
+            resp->data[3] = SD_RSPBUF(0);
+        }
+        else
+        {
+            resp->data[0] = (SD_RSPBUF(1) & 0xff) << 24 | SD_RSPBUF(0) >> 8;
+        }
+    }
+
+    /* R1b: give the card time to release DAT0 */
+    if (cmd->flags & SDMMC_RESP_BUSY)
+        udelay(500);
+
+    return SDMMC_STATUS_OK;
+}
+
+/* host test-mode statistics at 0x137800 (plugin buffer, idle in USB mode):
+ * "SDST", per command {count, timeouts, errors, total us} for CMD0..63 */
+#define SDSTAT ((volatile uint32_t *)0x137800)
+
+static uint32_t sd_rca;
+static bool sd_last_was_write, sd_cmd23;
+
+static int sd_submit_command(void *controller,
+                             const struct sdmmc_host_command *cmd,
+                             struct sdmmc_host_response *resp)
+{
+    struct sdmmc_host_response r;
+    uint32_t t0 = 0;
+#ifndef BOOTLOADER
+    extern bool atj_is_testmode(void);
+    /* the built-in MP3 decoder uses the plugin buffer for its output */
+    extern volatile bool codec_builtin_mp3_active;
+    bool stat = atj_is_testmode() && cmd->command < 64 &&
+                !codec_builtin_mp3_active;
+#else
+    const bool stat = false;
+#endif
+    if (stat)
+    {
+        if (SDSTAT[0] != 0x54534453)
+        {
+            for (int i = 0; i < 1 + 64 * 4; i++)
+                SDSTAT[i] = 0;
+            SDSTAT[0] = 0x54534453;
+        }
+        t0 = USEC_TIMER;
+    }
+    int ret = sd_submit_command_raw(controller, cmd, &r);
+    if (stat)
+    {
+        volatile uint32_t *e = &SDSTAT[1 + 4 * cmd->command];
+        e[0]++;
+        if (ret == SDMMC_STATUS_TIMEOUT)
+            e[1]++;
+        else if (ret)
+            e[2]++;
+        e[3] += USEC_TIMER - t0;
+    }
+    sd_trace((uint32_t)cmd->command << 24 | (cmd->flags & 0xffff) << 8 | (ret & 0xff),
+             SD_STATE << 16 | (r.data[0] >> 16));
+
+    /* the card's address, for the status polls below */
+    if (cmd->command == 3 && ret == SDMMC_STATUS_OK)
+        sd_rca = r.data[0] & 0xffff0000u;
+
+    /* After a write the card programs its flash with DAT0 held low; this
+     * controller does not wait for that, so poll CMD13 until the card is
+     * back in the transfer state and ready for data. */
+    if (ret == SDMMC_STATUS_OK && sd_rca &&
+        (cmd->command == 24 || (cmd->command == 25 && sd_cmd23) ||
+         (cmd->command == 12 && sd_last_was_write)))
+    {
+        static const struct sdmmc_host_command st = { .command = 13,
+                                                      .flags = SDMMC_RESP_SHORT };
+        struct sdmmc_host_command c = st;
+        c.argument = sd_rca;
+        long end = current_tick + HZ;
+        while (1)
+        {
+            struct sdmmc_host_response sr;
+            if (sd_submit_command_raw(controller, &c, &sr) == SDMMC_STATUS_OK &&
+                (sr.data[0] & (1u << 8)) && ((sr.data[0] >> 9) & 0xf) == 4)
+                break;
+            if (TIME_AFTER(current_tick, end))
+                break;
+            yield();
+        }
+    }
+    /* CMD25 after CMD23 ends by itself; otherwise CMD12 ends it */
+    sd_cmd23 = (cmd->command == 23 && ret == SDMMC_STATUS_OK);
+    if (cmd->command == 24 || cmd->command == 25)
+        sd_last_was_write = true;
+    else if (cmd->command == 17 || cmd->command == 18)
+        sd_last_was_write = false;
+
+    if (resp)
+        *resp = r;
+    return ret;
+}
+
+static const struct sdmmc_controller_ops sd_ops = {
+    .set_power_enabled = sd_set_power_enabled,
+    .set_bus_width = sd_set_bus_width,
+    .set_bus_clock = sd_set_bus_clock,
+    .submit_command = sd_submit_command,
+};
+
+static const struct sdmmc_host_config sd_config = {
+    .type = STORAGE_SD,
+    .bus_voltages = SDMMC_BUS_VOLTAGE_3V2_3V3 | SDMMC_BUS_VOLTAGE_3V3_3V4,
+    .bus_widths = SDMMC_BUS_WIDTH_1BIT | SDMMC_BUS_WIDTH_4BIT,
+    .bus_clocks = SDMMC_BUS_CLOCK_400KHZ | SDMMC_BUS_CLOCK_25MHZ,
+    .max_nr_blocks = 16,            /* 8 KiB reads (CMD18 + CMD23/CMD12) */
+    .max_nr_blocks_write = 16,      /* CMD25, card-ready polled after */
+    .is_removable = false,
+};
+
+void sdmmc_host_target_init(void)
+{
+    sdmmc_host_init(&sd_host, &sd_config, &sd_ops, NULL);
+}
