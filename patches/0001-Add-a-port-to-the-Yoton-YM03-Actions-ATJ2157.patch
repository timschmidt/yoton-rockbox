+#if defined(YOTON_YM03) && (CONFIG_PLATFORM & PLATFORM_NATIVE)
+/* test mode: start a 100 Hz PC sampler 1 s after PCM starts (1000 samples,
+ * 10 s) and note elapsed vs. real time at +5 s and +10 s */
+void ym03_wps_profile_tick(void)
+{
+    extern volatile unsigned long ym03_pcm_starts;
+    extern volatile uint32_t *ym03_cpu_samples;
+    extern volatile uint32_t ym03_cpu_nsamples, ym03_cpu_max;
+    static long t0;
+    if (*(volatile uint32_t *)0x137fe8 == 0x524c4146)       /* "FALR" */
+    {
+        /* rodata faults only, {addr, pc}, from the start of playback */
+        extern volatile uint32_t *pager_log;
+        extern volatile uint32_t pager_log_n, pager_log_max;
+        extern volatile int pager_log_ro_only;
+        volatile uint32_t *h = (volatile uint32_t *)0x307c00;
+        /* playback started: freeze the ring the pager filled since boot */
+        h[1] = pager_log_n;
+        pager_log = NULL;
+        (void)pager_log_max; (void)pager_log_ro_only;
+        return;
+    }
+    /* the built-in MP3 decoder uses the plugin buffer: profile into the
+     * 1 KiB left at the top of SRAM3 then */
+    extern volatile bool codec_builtin_mp3_active;
+    volatile uint32_t *hdr = codec_builtin_mp3_active ?
+        (volatile uint32_t *)0x307c00 : (volatile uint32_t *)0x137000;
+    uint32_t hmax = codec_builtin_mp3_active ? 250 : 700;
+    if (!t0 && ym03_pcm_starts)
+        t0 = current_tick;
+    if (!t0)
+        return;
+    long dt = current_tick - t0;
+    extern volatile uint32_t *pager_log;
+    extern volatile uint32_t pager_log_n, pager_log_max;
+    bool faults = *(volatile uint32_t *)0x137fe8 == 0x544c4146;  /* "FALT" */
+    /* UI test: profile the key-press phase instead of the start ("BACK" at
+     * 0x137fdc: from just before the Back press instead) */
+    bool ui = *(volatile uint32_t *)0x137fec == 0x31534955;
+    long pstart = !ui ? HZ :
+        *(volatile uint32_t *)0x137fdc == 0x4b434142 ? 3 * HZ - 1 : 4 * HZ;
+    if (dt == pstart && *(volatile uint32_t *)0x137fd8 != 0x354c4f56)  /* not VOL5 */
+    {
+        hdr[0] = faults ? 0x46525059 : 0x55504359;  /* "YPRF" / "YCPU" */
+        if (faults)
+        {
+            pager_log_n = 0;
+            pager_log_max = hmax;
+            pager_log = &hdr[2];
+        }
+        else
+        {
+            ym03_cpu_max = hmax;
+            ym03_cpu_nsamples = 0;
+            ym03_cpu_samples = &hdr[2];
+            /* 1 kHz (0.25 s) around the Back press, else 100 Hz */
+            timer_set(TIMER_FREQ / (pstart == 3 * HZ - 1 ? 1000 : 100), true);
+            timer_start();
+        }
+    }
+    if (faults && pager_log)
