+ ****************************************************************************/
+/*
+ * Hardware timer API. The ATJ2157 timer block is not identified yet, so
+ * timer_set() refuses every request; users fall back gracefully.
+ */
+#include "config.h"
+#include "system.h"
+#include "timer.h"
+
+/* RTC-block timer T0: 24 MHz, CTL bit 0 is the pending flag (cleared by
+ * writing the register back), 0x26 = IRQ enable | reload | run. Bring-up as
+ * the vendor KER_INIT does it (verified on hardware): timer block reset on
+ * RMU_RST0 bit 24, clock gate CMU_CLKEN0 bit 24, 0xc0000104 bit 0 and
+ * RTC_CTL bit 17 committed with the RTC update handshake. The vendor's
+ * "interrupt 18" is an exception number: NVIC line 2 (measured). */
+#define T0_CTL      ATJ_REG(0xc0030100)
+#define T0_VAL      ATJ_REG(0xc0030104)
+#define T0_RUN      0x26
+#define T0_IRQ      2
+#define NVIC_ISER0  ATJ_REG(0xe000e100)
+#define NVIC_ICER0  ATJ_REG(0xe000e180)
+
+/* host test-mode CPU profiler: interrupted PCs go to ym03_cpu_samples */
+volatile uint32_t *ym03_cpu_samples;
+volatile uint32_t ym03_cpu_nsamples, ym03_cpu_max;
+
+void timer_irq_handler(void)
+{
+    T0_CTL = T0_CTL;                /* ack */
+    if (ym03_cpu_samples && ym03_cpu_nsamples < ym03_cpu_max)
+    {
+        uint32_t exc = (uint32_t)__builtin_return_address(0);
+        uint32_t *frame;
+        if (exc & 4)
+            asm volatile ("mrs %0, psp" : "=r" (frame));
+        else
+            frame = (uint32_t *)__builtin_frame_address(0) + 2; /* approx */
+        ym03_cpu_samples[ym03_cpu_nsamples++] = (exc & 4) ? frame[6] : 0xfffffff0;
+    }
+    if (pfn_timer != NULL)
+        pfn_timer();
+}
+
+static void timer_hw_init(void)
+{
+    static bool done;
+    if (done)
+        return;
+    done = true;
+    RMU_RST0 &= ~(1u << 24);
+    udelay(5);
+    RMU_RST0 |= 1u << 24;
+    CMU_CLKEN0 |= 1u << 24;
+    ATJ_REG(0xc0000104) |= 1;
+    ATJ_REG(0xc0030000) |= 0x20000;
+    ATJ_REG(0xc0030004) = 0xa596;
+    for (int i = 0; i < 100000 && ATJ_REG(0xc0030004) != 0x5a69; i++);
+}
+
+bool timer_set(long cycles, bool start)
+{
+    if (cycles <= 0)
+        return false;
+
+    int oldstatus = disable_irq_save();
+    if (start && pfn_unregister != NULL)
+    {
+        pfn_unregister();
+        pfn_unregister = NULL;
+    }
+    timer_hw_init();
+    T0_CTL = 0;
+    T0_VAL = cycles;
+    T0_CTL = T0_RUN | 1;            /* also clears a stale pending flag */
+    restore_irq(oldstatus);
+    return true;
+}
+
+bool timer_start(IF_COP_VOID(int core))
+{
+    int oldstatus = disable_irq_save();
+    NVIC_ISER0 = 1u << T0_IRQ;
+    restore_irq(oldstatus);
+    return true;
+}
+
+void timer_stop(void)
+{
+    int oldstatus = disable_irq_save();
+    NVIC_ICER0 = 1u << T0_IRQ;
+    T0_CTL = 1;                     /* stop, ack */
+    restore_irq(oldstatus);
+}
diff --git a/firmware/target/arm/atj2157/usb-atj2157.c b/firmware/target/arm/atj2157/usb-atj2157.c
new file mode 100644
index 0000000..d58cfc2
--- /dev/null
+++ b/firmware/target/arm/atj2157/usb-atj2157.c
@@ -0,0 +1,823 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * ATJ2157 USB device controller: a Faraday FOTG210 device core (registers
+ * 0x100-0x1ff) with an Actions DMA engine (0x300-0x33c) in place of the
+ * FOTG210 DMA/PIO port. Register map: re/usb_controller.md, recovered from
+ * the boot ROM's ADFU stack and the stock firmware's UDISK.AP.
+ *
+ * Endpoints are fixed like the stock firmware's: EP1 bulk IN on FIFO 0, EP2
+ * bulk OUT on FIFO 2. Each Actions DMA channel k serves FIFO k (channel 0 of
+ * the data channels is at 0x308), the EP0 channel is at 0x300.
+ *
+ * Completions are never reported from inside a usb_drv_* call: they are
+ * queued and delivered from the USB interrupt (pended in software) or the
+ * tick, so the core never re-enters itself.
+ *
