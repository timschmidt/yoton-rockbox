+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+/* Backlight: GPIO22 driven by PWM channel 4 (from vendor DRV_LCD.DRV) */
+#include "system.h"
+#include "backlight.h"
+#include "backlight-target.h"
+
+#define PIN_BL      22
+#define BL_PWM      4
+#define BL_PERIOD   16
+
+static int bl_level = DEFAULT_BRIGHTNESS_SETTING;
+
+bool backlight_hw_init(void)
+{
+    atj_module_enable(CLKEN0_PWM, CLKEN0_PWM);
+    CMU_PWMCLK(BL_PWM) = (CMU_PWMCLK(BL_PWM) & ~0x1ff) | 0x200 | 0xf;
+    PWM_PERIOD(BL_PWM) = (PWM_PERIOD(BL_PWM) & ~0xffff) | BL_PERIOD;
+    backlight_hw_on();
+    return true;
+}
+
+void backlight_hw_on(void)
+{
+    PWM_DUTY(BL_PWM) = (PWM_DUTY(BL_PWM) & ~0xffff) | bl_level;
+    PWM_CTL(BL_PWM) = (PWM_CTL(BL_PWM) & ~3) | 0x1c;
+    MFP_CTL(PIN_BL) = (MFP_CTL(PIN_BL) & ~0xdf) | 0x10;   /* PWM function */
+}
+
+void backlight_hw_off(void)
+{
+    MFP_CTL(PIN_BL) = (MFP_CTL(PIN_BL) & ~MFP_FUNC_MASK) | MFP_GPIO_OUT;
+    atj_gpio_set(PIN_BL, 0);
+}
+
+void backlight_hw_brightness(int brightness)
+{
+    if (brightness < MIN_BRIGHTNESS_SETTING)
+        brightness = MIN_BRIGHTNESS_SETTING;
+    if (brightness > MAX_BRIGHTNESS_SETTING)
+        brightness = MAX_BRIGHTNESS_SETTING;
+    bl_level = brightness;
+    PWM_DUTY(BL_PWM) = (PWM_DUTY(BL_PWM) & ~0xffff) | bl_level;
+}
