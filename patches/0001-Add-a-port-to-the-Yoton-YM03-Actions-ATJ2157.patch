+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#include "config.h"
+#include "system.h"
+#include "kernel.h"
+#include "string.h"
+#include "usb.h"
+#include "usb_ch9.h"
+#include "usb_core.h"
+#include "usb_drv.h"
+
+#define USB(o)          ATJ_REG(0xc0140000 + (o))
+#define DMCR            USB(0x100)
+#define  DMCR_GLINT_EN  (1 << 2)
+#define  DMCR_GOSUSP    (1 << 3)
+#define  DMCR_SFRST     (1 << 4)
+#define  DMCR_CHIP_EN   (1 << 5)
+#define  DMCR_HS        (1 << 6)
+#define  DMCR_FORCE_FS  (1 << 9)
+#define DAR             USB(0x104)
+#define  DAR_AFT_CONF   (1 << 7)
+#define DTR             USB(0x108)
+#define SOFFNR          USB(0x10c)
+#define PHYTMSR         USB(0x114)
+#define  PHY_UNPLUG     (1 << 0)
+#define CXFIFO          USB(0x120)
+#define  CX_DONE        (1 << 0)
+#define  CX_STALL       (1 << 2)
+#define IDLE            USB(0x124)
+#define GIMR            USB(0x130)
+#define GIMR0           USB(0x134)
+#define GIMR1           USB(0x138)
+#define GIMR2           USB(0x13c)
+#define GISR            USB(0x140)
+#define GISR0           USB(0x144)
+#define GISR1           USB(0x148)
+#define GISR2           USB(0x14c)
+#define INEPMPS(n)      USB(0x160 + 4 * ((n) - 1))
+#define OUTEPMPS(n)     USB(0x180 + 4 * ((n) - 1))
+#define  EP_STALL       (1 << 11)
+#define  EP_RSTG        (1 << 12)
+#define EPMAP14         USB(0x1a0)
+#define EPMAP58         USB(0x1a4)
+#define FIFOMAP         USB(0x1a8)
+#define FIFOCF          USB(0x1ac)
+#define FIBC(k)         USB(0x1b0 + 4 * (k))
+#define  FIBC_FFRST     (1 << 12)
+#define DMA0_CTL        USB(0x300)
+#define DMA0_ADDR       USB(0x304)
+#define DMAK_CTL(k)     USB(0x308 + 8 * (k))
+#define DMAK_ADDR(k)    USB(0x30c + 8 * (k))
+#define DMA_STAT        USB(0x328)
+#define DMA_EN          USB(0x330)
+#define  UDMA_START     (1 << 0)
+#define  UDMA_IN        (1 << 1)
+
+#define FIFO_IN         0           /* EP1 IN */
+#define FIFO_OUT        2           /* EP2 OUT */
+#define EP_IN_NUM       1
+#define EP_OUT_NUM      2
+#define USB_IRQ         12
+#define NVIC_ISER0      ATJ_REG(0xe000e100)
+#define NVIC_ICER0      ATJ_REG(0xe000e180)
+#define NVIC_ISPR0      ATJ_REG(0xe000e200)
+
+struct usb_drv_ep_spec usb_drv_ep_specs[USB_NUM_ENDPOINTS] = {
+    {.type = {USB_ENDPOINT_XFER_CONTROL, USB_ENDPOINT_XFER_CONTROL}},
+    {.type = {USB_ENDPOINT_TYPE_NONE, USB_ENDPOINT_XFER_BULK}},  /* EP1 IN */
+    {.type = {USB_ENDPOINT_XFER_BULK, USB_ENDPOINT_TYPE_NONE}},  /* EP2 OUT */
+};
+uint8_t usb_drv_ep_specs_flags = 0;
+
+struct xfer
+{
+    uint8_t *buf;
+    int len;            /* requested */
+    int done;           /* transferred so far */
+    int chunk;          /* bytes of the DMA in flight (IN) */
+    bool busy;
+    bool bounce;        /* chunk goes through bounce[] */
+};
+
+static struct xfer ep_in, ep_out;
+static bool ep0_status_armed;   /* core waits for the status stage (OUT) */
+static uint16_t ep0_wlength;
+static bool enabled;
+
+/* pending completions, delivered from irq context */
+#define C_EP0_IN    (1 << 0)
+#define C_EP0_OUT   (1 << 1)
+#define C_EP0_IN_ERR (1 << 2)
+#define C_EP0_OUT_ERR (1 << 3)
+#define C_IN        (1 << 4)
+#define C_OUT       (1 << 5)
+static volatile unsigned pending;
+static int ep0_in_len, ep0_out_len, in_result, out_result;
+
+/* event trace for bring-up, in the (unused) plugin buffer so it survives
+ * a reboot into the boot ROM: "UTRC", count, then {tag|arg, value} */
+#define UTRACE ((volatile uint32_t *)0x137000)
+static void ut(uint32_t tag, uint32_t v)
+{
+#ifndef YM03_USB_TRACE
+    (void)tag; (void)v;
+    return;
+#endif
+    uint32_t n = UTRACE[1];
+    if (n < 250)
+    {
+        UTRACE[2 + 2 * n] = tag;
+        UTRACE[3 + 2 * n] = v;
+        UTRACE[1] = n + 1;
+    }
+}
+
+static uint8_t setup_buf[8] __attribute__((aligned(4)));
+static uint8_t ep0_buf[256] __attribute__((aligned(4)));
+static uint8_t bounce[512] __attribute__((aligned(4)));
+
+static inline bool dma_reachable(const void *p, int len)
+{
+    uintptr_t a = (uintptr_t)p;
+    return !(a & 3) && a >= 0x100000 && a + len <= 0x138000;
+}
+
+static int mps(void)
+{
+    return (DMCR & DMCR_HS) ? 512 : 64;
+}
+
+/* bounded busy wait for one DMA (EP0 channel: bit 0/16, FIFO k: 1+k/17+k) */
+static int dma_wait(unsigned done_bit, unsigned err_bit)
+{
+    for (int i = 0; i < 400000; i++)
+    {
+        uint32_t s = DMA_STAT;
+        if (s & err_bit)
+        {
+            DMA_STAT = err_bit | done_bit;
+            return -1;
+        }
+        if (s & done_bit)
+        {
+            DMA_STAT = done_bit;
+            return 0;
+        }
+        if (GISR2 & 1)          /* bus reset: give up */
+            return -1;
+    }
+    return -1;
+}
+
+static int ep0_dma(void *buf, int len, bool in)
+{
+    DMA0_CTL = ((uint32_t)len << 8) | (in ? UDMA_IN : 0);
+    DMA0_ADDR = (uintptr_t)buf;
+    DMA_EN = 1;
+    DMA0_CTL |= UDMA_START;
+    int rc = dma_wait(1 << 0, 1 << 16);
+    if (rc)
+    {
+        DMA_EN = 0;
+        DMA0_CTL = 0;
+    }
+    return rc;
+}
+
+static void kick(unsigned what)
+{
+    pending |= what;
+    NVIC_ISPR0 = 1u << USB_IRQ;         /* deliver from the USB interrupt */
+}
+
+/* --- bulk IN (EP1, FIFO 0) ------------------------------------------------ */
+
+static void in_start_chunk(void)
+{
+    struct xfer *x = &ep_in;
+    int left = x->len - x->done;
+    uint8_t *src = x->buf + x->done;
+
+    x->bounce = !dma_reachable(src, left);
+    if (x->bounce)
+    {
+        x->chunk = MIN(left, (int)sizeof(bounce));
+        memcpy(bounce, src, x->chunk);
+        src = bounce;
+    }
+    else
+        x->chunk = MIN(left, 32768);
+
+    DMAK_CTL(FIFO_IN) = ((uint32_t)x->chunk << 8) | UDMA_IN;
+    DMAK_ADDR(FIFO_IN) = (uintptr_t)src;
+    DMA_EN = 1;
+    DMAK_CTL(FIFO_IN) |= UDMA_START;
+}
+
+/* poll the IN DMA; irq context */
+static void in_poll(void)
+{
+    struct xfer *x = &ep_in;
+    if (!x->busy)
+        return;
+
+    uint32_t s = DMA_STAT;
+    if (s & (1u << (17 + FIFO_IN)))
+    {
+        DMA_STAT = (1u << (17 + FIFO_IN)) | (1u << (1 + FIFO_IN));
+        x->busy = false;
+        in_result = -1;
+        usb_core_transfer_complete(EP_IN_NUM, USB_DIR_IN, -1, 0);
+        return;
+    }
+    if (!(s & (1u << (1 + FIFO_IN))))
+        return;
+
+    DMA_STAT = 1u << (1 + FIFO_IN);
+    ut(0x44000000 | x->chunk, s);
+    x->done += x->chunk;
+    if (x->done < x->len)
+    {
+        in_start_chunk();
+        return;
+    }
+    x->busy = false;
+    usb_core_transfer_complete(EP_IN_NUM, USB_DIR_IN, 0, x->len);
+}
+
+/* --- bulk OUT (EP2, FIFO 2): one packet per interrupt, like UDISK.AP ----- */
+
+static void out_arm(bool on)
+{
+    if (on)
+        GIMR1 &= ~((1u << (2 * FIFO_OUT)) | (1u << (2 * FIFO_OUT + 1)));
+    else
+        GIMR1 |= (1u << (2 * FIFO_OUT)) | (1u << (2 * FIFO_OUT + 1));
+}
+
+static void out_packet(void)
+{
+    struct xfer *x = &ep_out;
+    if (!x->busy)
+    {
+        out_arm(false);
+        return;
+    }
+
+    int n = FIBC(FIFO_OUT) & 0x7ff;
+    ut(0x4f000000 | n, x->len - x->done);
+    int room = x->len - x->done;
+    bool short_pkt = n < mps();
+
+    if (n > room)                       /* host sent more than asked: drop */
+        n = room;
+    if (n > 0)
+    {
+        uint8_t *dst = x->buf + x->done;
+        bool direct = dma_reachable(dst, n);
+        DMAK_CTL(FIFO_OUT) = (uint32_t)n << 8;
+        DMAK_ADDR(FIFO_OUT) = (uintptr_t)(direct ? dst : bounce);
+        DMA_EN = 1;
+        DMAK_CTL(FIFO_OUT) |= UDMA_START;
+        if (dma_wait(1u << (1 + FIFO_OUT), 1u << (17 + FIFO_OUT)))
+        {
+            DMA_EN = 0;
+            DMAK_CTL(FIFO_OUT) = 0;
+            FIBC(FIFO_OUT) |= FIBC_FFRST;
+            x->busy = false;
+            out_arm(false);
+            usb_core_transfer_complete(EP_OUT_NUM, USB_DIR_OUT, -1, 0);
+            return;
+        }
+        if (!direct)
+            memcpy(dst, bounce, n);
+        ut(0x42000000 | n, ((uint32_t *)dst)[0]);
+        ut(0x42000000 | n, ((uint32_t *)dst)[3]);   /* CDB[0] in byte 15 */
+        x->done += n;
+    }
+    else
+        FIBC(FIFO_OUT) |= FIBC_FFRST;   /* zero length packet */
+
+    if (short_pkt || x->done >= x->len)
+    {
+        x->busy = false;
+        out_arm(false);
+        usb_core_transfer_complete(EP_OUT_NUM, USB_DIR_OUT, 0, x->done);
+    }
+}
+
+/* --- EP0 ------------------------------------------------------------------ */
+
+static void deliver(void)
+{
+    unsigned p;
+    int oldlevel = disable_irq_save();
+    p = pending;
+    pending = 0;
+    restore_irq(oldlevel);
+
+    if (p & C_EP0_IN)
+        usb_core_transfer_complete(EP_CONTROL, USB_DIR_IN, 0, ep0_in_len);
+    if (p & C_EP0_IN_ERR)
+        usb_core_transfer_complete(EP_CONTROL, USB_DIR_IN, -1, 0);
+    if (p & C_EP0_OUT)
+        usb_core_transfer_complete(EP_CONTROL, USB_DIR_OUT, 0, ep0_out_len);
+    if (p & C_EP0_OUT_ERR)
+        usb_core_transfer_complete(EP_CONTROL, USB_DIR_OUT, -1, 0);
+    (void)in_result; (void)out_result;
+}
+
+static void setup_received(void)
+{
+    struct usb_ctrlrequest *req = (struct usb_ctrlrequest *)setup_buf;
+
+    if (ep0_dma(setup_buf, 8, false))
+        return;
+
+    /* a new SETUP ends whatever control transfer was pending */
+    ep0_status_armed = false;
+    pending &= ~(C_EP0_IN | C_EP0_OUT | C_EP0_IN_ERR | C_EP0_OUT_ERR);
+
+    if (usb_drv_is_set_address(req))
+    {
+        /* applied by the core after the status stage */
+        DAR = (DAR & DAR_AFT_CONF) | (req->wValue & 0x7f);
+        CXFIFO |= CX_DONE;
+        usb_core_notify_set_address(req->wValue & 0x7f);
+        return;
+    }
+    if (req->bRequestType == (USB_DIR_OUT | USB_TYPE_STANDARD | USB_RECIP_DEVICE)
+        && req->bRequest == USB_REQ_SET_CONFIGURATION)
+    {
+        if (req->wValue)
+            DAR |= DAR_AFT_CONF;
+        else
+            DAR &= ~DAR_AFT_CONF;
+    }
+
+    ep0_wlength = req->wLength;
+    ut(0x53000000 | req->bRequest, ((uint32_t *)setup_buf)[0]);
+    usb_core_setup_received(req);
+}
+
+/* --- interrupt / tick ------------------------------------------------------ */
+
+static void bus_reset(void)
+{
+    DAR = 0;
+    DTR |= 1;
+    for (int n = 1; n <= 8; n++)
+    {
+        INEPMPS(n) = EP_RSTG;
+        OUTEPMPS(n) = EP_RSTG;
+        INEPMPS(n) = 0;
+        OUTEPMPS(n) = 0;
+    }
+    EPMAP14 = EPMAP58 = 0x33333333;
+    FIFOMAP = 0x0f0f0f0f;
+    FIFOCF = 0;
+    DMA_EN = 0;
+    DMA0_CTL = 0;
+    for (int k = 0; k < 4; k++)
+        DMAK_CTL(k) = 0;
+    DMA_STAT = 0x001f001f;
+    GIMR1 = 0x000f00ff;
+
+    ep0_status_armed = false;
+    pending = 0;
+    usb_drv_cancel_all_transfers();
+    usb_core_bus_reset();
+}
+
+void usb_irq_handler(void)
+{
+    if (!enabled)
+        return;
+
+    uint32_t g = GISR & ~GIMR;
+    ut(0x49000000 | (g & 0xff), GISR1 | (GISR2 << 24));
+
+    if (g & 4)
+    {
+        uint32_t s = GISR2 & ~GIMR2;
+        if (s & 1)
+            bus_reset();
+        GISR2 = s & 7;
+    }
+    if (g & 1)
+    {
+        uint32_t s = GISR0 & ~GIMR0;
+        if (s & 1)
+            setup_received();
+    }
+    if (g & 2)
+    {
+        uint32_t s = GISR1 & ~GIMR1;
+        if (s & (3u << (2 * FIFO_OUT)))
+            out_packet();
+    }
+    in_poll();
+    deliver();
+}
+
+static void usb_tick(void)
+{
+    if (!enabled)
+        return;
+    /* control-in requests answered with no data: the core armed the status
+     * stage and will send nothing, so finish it here */
+    if (ep0_status_armed)
+    {
+        ep0_status_armed = false;
+        CXFIFO |= CX_DONE;
+        ep0_out_len = 0;
+        pending |= C_EP0_OUT;
+    }
+    in_poll();
+    deliver();
+}
+
+/* --- driver API ----------------------------------------------------------- */
+
+int usb_drv_send_nonblocking(int endpoint, void *ptr, int length)
+{
+    int ep = EP_NUM(endpoint);
+    int oldlevel = disable_irq_save();
+
+    if (ep == EP_CONTROL)
+    {
+        int rc = 0;
+        if (length > ep0_wlength)
+            length = ep0_wlength;
+        if (length > (int)sizeof(ep0_buf))
+            length = sizeof(ep0_buf);
+        if (length > 0)
+        {
+            memcpy(ep0_buf, ptr, length);
+            rc = ep0_dma(ep0_buf, length, true);
+        }
+        if (rc == 0)
+        {
+            /* data (if any) is in: let the core run the status stage */
+            CXFIFO |= CX_DONE;
+            ep0_in_len = length;
+            if (ep0_status_armed)
+            {
+                ep0_status_armed = false;
+                ep0_out_len = 0;
+                kick(C_EP0_IN | C_EP0_OUT);
+            }
+            else
+                kick(C_EP0_IN);
+        }
+        else
+            kick(C_EP0_IN_ERR);
+        restore_irq(oldlevel);
+        return rc;
+    }
+
+    ut(0x54000000 | (ep << 16) | (length & 0xffff), (uint32_t)ptr);
+    if (ep != EP_IN_NUM)
+    {
+        restore_irq(oldlevel);
+        return -1;
+    }
+    ep_in.buf = ptr;
+    ep_in.len = length;
+    ep_in.done = 0;
+    ep_in.busy = true;
+    if (length == 0)
+    {
+        /* zero length packet: FOTG210 sends one for an empty DMA (unverified) */
+        ep_in.chunk = 0;
+        DMAK_CTL(FIFO_IN) = UDMA_IN;
+        DMAK_ADDR(FIFO_IN) = (uintptr_t)bounce;
+        DMA_EN = 1;
+        DMAK_CTL(FIFO_IN) |= UDMA_START;
+    }
+    else
+        in_start_chunk();
+    restore_irq(oldlevel);
+    /* a bulk chunk normally leaves within a fraction of a millisecond:
+     * wait for it here instead of for the next tick */
+    for (int t = 0; t < 2000 && !(DMA_STAT & (1u << (1 + FIFO_IN) | 1u << (17 + FIFO_IN))); t++)
+        udelay(1);
+    kick(0);
+    return 0;
+}
+
+int usb_drv_send(int endpoint, void *ptr, int length)
+{
+    int rc = usb_drv_send_nonblocking(endpoint, ptr, length);
+    if (rc || EP_NUM(endpoint) == EP_CONTROL)
+        return rc;
+    long end = current_tick + HZ;
+    while (ep_in.busy && TIME_BEFORE(current_tick, end))
+        yield();
+    return ep_in.busy ? -1 : 0;
+}
+
+int usb_drv_recv_nonblocking(int endpoint, void *ptr, int length)
+{
+    int ep = EP_NUM(endpoint);
+    int oldlevel = disable_irq_save();
+
+    if (ep == EP_CONTROL)
+    {
+        int rc = 0;
+        if (length == 0)
+        {
+            /* status stage of a control read: finished by the next send,
+             * or by the tick if there is no data stage */
+            ep0_status_armed = true;
+        }
+        else
+        {
+            uint8_t *dst = dma_reachable(ptr, length) ? ptr : ep0_buf;
+            if (length > (int)sizeof(ep0_buf))
+                length = sizeof(ep0_buf);
+            rc = ep0_dma(dst, length, false);
+            if (rc == 0)
+            {
+                if (dst != ptr)
+                    memcpy(ptr, ep0_buf, length);
+                ep0_out_len = length;
+                kick(C_EP0_OUT);
+            }
+            else
+                kick(C_EP0_OUT_ERR);
+        }
+        restore_irq(oldlevel);
+        return rc;
+    }
+
+    ut(0x52000000 | (ep << 16) | (length & 0xffff), (uint32_t)ptr);
+    if (ep != EP_OUT_NUM)
+    {
+        restore_irq(oldlevel);
+        return -1;
+    }
+    ep_out.buf = ptr;
+    ep_out.len = length;
+    ep_out.done = 0;
+    ep_out.busy = true;
+    out_arm(true);
+    restore_irq(oldlevel);
+    return 0;
+}
+
+int usb_drv_recv_blocking(int endpoint, void *ptr, int length)
+{
+    int rc = usb_drv_recv_nonblocking(endpoint, ptr, length);
+    if (rc || EP_NUM(endpoint) == EP_CONTROL)
+        return rc;
+    long end = current_tick + HZ;
+    while (ep_out.busy && TIME_BEFORE(current_tick, end))
+        yield();
+    return ep_out.busy ? -1 : ep_out.done;
+}
+
+void usb_drv_ep_init(const struct usb_drv_ep_alloc_ctx *ctx, int ep)
+{
+    (void)ctx;
+    int n = EP_NUM(ep);
+    ut(0x45000000 | (ep & 0xff), mps());
+
+    if (n == EP_IN_NUM)
+        INEPMPS(EP_IN_NUM) = mps();
+    else if (n == EP_OUT_NUM)
+        OUTEPMPS(EP_OUT_NUM) = mps();
+    else
+        return;
+
+    /* stock mapping: EP1 IN -> FIFO0 (double buffered), EP2 OUT -> FIFO2 */
+    EPMAP14 = (EPMAP14 & ~0x3003u) | 0x2000;
+    FIFOMAP = (FIFOMAP & 0xff00ff00u) | 0x00020011;
+    FIFOCF = 0x00220022;                    /* single-buffered, as the ROM */
+}
+
+void usb_drv_ep_deinit(const struct usb_drv_ep_alloc_ctx *ctx, int ep)
+{
+    (void)ctx;
+    (void)ep;
+}
+
+void usb_drv_stall(int endpoint, bool stall, bool in)
+{
+    int n = EP_NUM(endpoint);
+    if (n == EP_CONTROL)
+    {
+        if (stall)
+            CXFIFO |= CX_STALL;
+        return;
+    }
+    volatile uint32_t *r = in ? &INEPMPS(n) : &OUTEPMPS(n);
+    if (stall)
+        *r |= EP_STALL;
+    else
+    {
+        *r &= ~EP_STALL;
+        *r |= EP_RSTG;
+        *r &= ~EP_RSTG;
+    }
+}
+
+bool usb_drv_stalled(int endpoint, bool in)
+{
+    int n = EP_NUM(endpoint);
+    if (n == EP_CONTROL)
+        return CXFIFO & CX_STALL;
+    return (in ? INEPMPS(n) : OUTEPMPS(n)) & EP_STALL;
+}
+
+void usb_drv_reset_endpoint(int endpoint, bool send)
+{
+    int n = EP_NUM(endpoint);
+    if (n == EP_CONTROL)
+        return;
+    volatile uint32_t *r = send ? &INEPMPS(n) : &OUTEPMPS(n);
+    *r |= EP_RSTG;
+    *r &= ~EP_RSTG;
+}
+
+void usb_drv_cancel_all_transfers(void)
+{
+    int oldlevel = disable_irq_save();
+    for (int k = 0; k < 4; k++)
+        DMAK_CTL(k) = 0;
+    DMA_STAT = 0x001e001e;
+    if (ep_in.busy)
+    {
+        ep_in.busy = false;
+        usb_core_transfer_complete(EP_IN_NUM, USB_DIR_IN, -1, 0);
+    }
+    if (ep_out.busy)
+    {
+        ep_out.busy = false;
+        out_arm(false);
+        usb_core_transfer_complete(EP_OUT_NUM, USB_DIR_OUT, -1, 0);
+    }
+    restore_irq(oldlevel);
+}
+
+int usb_drv_port_speed(void)
+{
+    return (DMCR & DMCR_HS) ? 1 : 0;
+}
+
+void usb_drv_set_test_mode(int mode)
+{
+    if (mode >= 1 && mode <= 4)
+        PHYTMSR |= 1u << mode;
+}
+
+bool usb_drv_powered(void)
+{
+    return usb_detect() == USB_INSERTED;
+}
+
+bool usb_drv_connected(void)
+{
+    return enabled && !(PHYTMSR & PHY_UNPLUG);
+}
+
+void usb_drv_startup(void)
+{
+}
+
+void usb_drv_int_enable(bool enable)
+{
+    if (enable)
+        NVIC_ISER0 = 1u << USB_IRQ;
+    else
+        NVIC_ICER0 = 1u << USB_IRQ;
+}
+
+static void pulse_rst0(int bit)
+{
+    RMU_RST0 &= ~(1u << bit);
+    udelay(10);
+    RMU_RST0 |= 1u << bit;
+    udelay(10);
+}
+
+/* controller bring-up, as the boot ROM (0x2d34) and UDISK.AP (0x109800) */
+void usb_drv_init(void)
+{
+    CMU_CLKEN0 |= 0x8001;
+    pulse_rst0(16);
+    ATJ_REG(0xc0001100) = 0x3055;           /* USB PHY clock (verbatim) */
+    pulse_rst0(15);
+
+    PHYTMSR |= PHY_UNPLUG;                  /* stay off the bus for now */
+    IDLE = 7;
+    DMCR |= DMCR_CHIP_EN;
+    DTR |= 1;
+    DMCR |= DMCR_SFRST;
+    for (int i = 0; i < 1000000 && (DMCR & DMCR_SFRST); i++);
+    DMCR |= 0x02;                           /* as the boot ROM (0x2e14) */
+    GISR0 = 0x20;
+    GISR2 = 0x1ff;
+    GIMR = 0;
+    GIMR0 = 0x3e;                           /* SETUP only */
+    GIMR1 = 0x000f00ff;                     /* FIFOs masked until armed */
+    GIMR2 = 0x7f8;                          /* reset, suspend, resume */
+    DMA_STAT = 0x001f001f;
+    USB(0x32c) = 0x001f001f;
+    USB(0x334) = 0;
+    USB(0x338) = 1;
+    USB(0x03c) = 0;                         /* boot ROM value */
+    USB(0x1c8) &= 0x3ffffffe;
+    DMA_EN = 1;
+    DMCR &= ~DMCR_FORCE_FS;
+    DMCR |= DMCR_GLINT_EN;
+
+#ifdef YM03_USB_TRACE
+    UTRACE[0] = 0x43525455;     /* "UTRC" */
+    UTRACE[1] = 0;
+#endif
+    ep_in.busy = ep_out.busy = false;
+    ep0_status_armed = false;
+    pending = 0;
+    enabled = true;
+    tick_add_task(usb_tick);
+    usb_drv_int_enable(true);
+}
+
+/* attach once the core is set up (see usb_enable) */
+static void usb_drv_connect(void)
+{
+    PHYTMSR |= PHY_UNPLUG;
+    mdelay(20);
+    PHYTMSR &= ~PHY_UNPLUG;
+}
+
+void usb_drv_exit(void)
+{
+    usb_drv_int_enable(false);
+    tick_remove_task(usb_tick);
+    enabled = false;
+    PHYTMSR |= PHY_UNPLUG;
+    DMCR |= DMCR_GOSUSP;
+    DMA_EN = 0;
+    RMU_RST0 &= ~(1u << 15);
+    RMU_RST0 &= ~(1u << 16);
+    CMU_CLKEN0 &= ~(1u << 15);
+}
+
+/* --- target glue ---------------------------------------------------------- */
+
+void usb_init_device(void)
+{
+    /* USB/VBUS power-up as the boot ROM's USB init does it (0x23c4): PMU
+     * bits 29 and 28, then 0xc0000114 = 0x88. After a cold NOR boot nothing
+     * else has done this and VBUS detection reads as absent. */
+    ATJ_REG(0xc0010000) |= 1u << 29;
+    udelay(5);
+    ATJ_REG(0xc0010000) |= 1u << 28;
+    ATJ_REG(0xc0000114) = 0x88;
+    udelay(500);
+    /* and, as the same ROM routine ends: memory access for the bus masters
+     * (the USB DMA cannot reach RAM without it after a cold boot) */
+    ATJ_REG(0xc0040004) |= 0xff;
+    usb_drv_startup();
+}
+
+/* VBUS as the stock kernel decides it (KT 0x1d8): PMU+0x28 bit 30, or the
+ * PMU+0x40 reading above 0x200. Not yet verified on hardware. */
+int usb_detect(void)
+{
+    /* host test runs keep the player out of USB mode unless asked */
+    extern bool atj_is_testmode(void), atj_test_usb_allowed(void);
+    if (atj_is_testmode() && !atj_test_usb_allowed())
+        return USB_EXTRACTED;
+    uint32_t st = ATJ_REG(0xc0010028), vb = ATJ_REG(0xc0010040) & 0x3ff;
+    if ((st & (1u << 30)) || vb > 0x200)
+        return USB_INSERTED;
+    return USB_EXTRACTED;
+}
+
+void usb_enable(bool on)
+{
+    if (on)
+    {
+        usb_core_init();
+        usb_drv_connect();
+    }
+    else
+        usb_core_exit();
+}
+
+void usb_attach(void)
+{
+    usb_enable(true);
+}
