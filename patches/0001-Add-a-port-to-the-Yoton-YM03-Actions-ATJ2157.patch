+/* sort settings for compare() */
+static void ft_set_cmp(struct tree_context *c)
+{
+    /* allow directories to be sorted into file list */
+    cmp_data.sort_dir = (*c->dirfilter == SHOW_PLUGINS) ? SORT_AS_FILE : c->sort_dir;
+
+    /* playlist catalog uses sorting independent from file browser */
+    cmp_data.sort_file = (*c->dirfilter == SHOW_M3U) ?
+                         global_settings.sort_playlists : global_settings.sort_file;
+
+    if (global_settings.sort_case)
+    {
+        if (global_settings.interpret_numbers == SORT_INTERPRET_AS_NUMBER)
+            cmp_data._compar = strnatcmp_n;
+        else
+            cmp_data._compar = strncmp;
+    }
+    else
+    {
+        if (global_settings.interpret_numbers == SORT_INTERPRET_AS_NUMBER)
+            cmp_data._compar = strnatcasecmp_n;
+        else
+            cmp_data._compar = strncasecmp;
+    }
+}
+
+#ifdef HAVE_DIR_WINDOW
+/*
+ * Windowed listing of a directory whose names do not fit the name buffer:
+ * one pass over the directory keeps the entries that sort right after
+ * (win_dir 1), from (2) or before (-1) the pivot entry, or the first ones
+ * (0), as many as fit. Entries at the window's edges move it.
+ */
+/* state of the one windowed directory (not in struct tree_context: the
+ * browser keeps copies of that) */
+static struct
+{
+    int dir;                    /* next load: 0 first, 1 after pivot,
+                                   -1 before pivot, 2 from pivot on */
+    unsigned crc;               /* directory the state is for */
+    int prev, next;             /* indices of the move entries, or -1 */
+    bool move;                  /* a move is pending: place the cursor */
+    int attr;                   /* pivot entry */
+    unsigned time;
+    char name[MAX_PATH];
+} win;
+
+static const char win_prev_name[] = "<< Previous entries";
+static const char win_next_name[] = "More entries >>";
+
+/* move the names to the start of the buffer (they are referenced only from
+ * ents[0..n)) */
+static size_t win_compact(struct entry *ents, int n, char *buf)
+{
+    /* order by address, then slide each name down */
+    int idx[n > 0 ? n : 1];
+    for (int i = 0; i < n; i++)
+    {
+        int j = i;
+        while (j > 0 && ents[idx[j - 1]].name > ents[i].name)
+        {
+            idx[j] = idx[j - 1];
+            j--;
+        }
+        idx[j] = i;
+    }
+    size_t used = 0;
+    for (int i = 0; i < n; i++)
+    {
+        struct entry *e = &ents[idx[i]];
+        size_t len = strlen(e->name) + 1;
+        memmove(buf + used, e->name, len);
+        e->name = buf + used;
+        used += len;
+    }
+    return used;
+}
+
+#ifdef YOTON_YM03
+volatile long ym03_win_stats[4];    /* loads, last pass ticks, entries, mode */
+#endif
+
+static int ft_load_window(struct tree_context *c,
+                          bool (*callback_show_item)(char *, int, struct tree_context *))
+{
+#ifdef YOTON_YM03
+    long t_start = current_tick;
+    {
+        /* host test: ring log of all faults during the first window load */
+        extern volatile uint32_t *pager_log;
+        extern volatile uint32_t pager_log_n, pager_log_max;
+        extern volatile int pager_log_ro_only;
+        if (*(volatile uint32_t *)0x137fdc == 0x53575242 && ym03_win_stats[0] == 0)
+        {
+            /* ring log of all faults {addr, pc} */
+            volatile uint32_t *h = (volatile uint32_t *)0x307c00 + 64;
+            h[0] = 0x46525059;
+            pager_log_n = 0;
+            pager_log_max = 190;
+            pager_log_ro_only = 2;
+            pager_log = &h[2];
+        }
+    }
+#endif
+    DIR *dir = opendir(c->currdir);
+    if (!dir)
+        return -1;
+
+    ft_set_cmp(c);
+    struct entry pivot = { .name = win.name, .attr = win.attr,
+                           .time_write = win.time };
+    int mode = win.dir;
+
+    tree_lock_cache(c);
+    struct entry *ents = tree_get_entries(c);
+    char *buf = core_get_data(c->cache.name_buffer_handle);
+    size_t bufsize = c->cache.name_buffer_size;
+    int cap = c->cache.max_entries - 2;         /* room for the move entries */
+    int n = 0;
+    size_t used = 0, live = 0;                  /* buffer used, of it live */
+    bool dropped = false;                       /* more beyond the window */
+    struct dirent *entry;
+
+    while ((entry = readdir(dir)))
+    {
+#ifdef UI_YIELD_POINT
+        UI_YIELD_POINT();
+#endif
+        struct entry cand;
+        unsigned mtime;
+        if (!ft_visible(c, dir, entry, callback_show_item, &cand.attr, &mtime))
+            continue;
+        cand.name = (char *)entry->d_name;
+        cand.time_write = mtime;
+
+        if (mode == 1 && compare(&cand, &pivot) <= 0)
+            continue;
+        if (mode == 2 && compare(&cand, &pivot) < 0)
+            continue;
+        if (mode == -1 && compare(&cand, &pivot) >= 0)
+            continue;
+
+        size_t len = strlen(cand.name) + 1;
+        if (len > bufsize)
+            continue;
+
+        /* the window keeps the entries nearest the pivot: the smallest
+         * ones, or the largest ones going backwards; ents[] is sorted.
+         * Evicted names stay in the buffer until it has to be compacted;
+         * compaction leaves a quarter of it free so that it stays rare. */
+        if (n == cap)
+        {
+            dropped = true;
+            struct entry *far = mode < 0 ? &ents[0] : &ents[n - 1];
+            if (mode < 0 ? compare(&cand, far) <= 0 : compare(&cand, far) >= 0)
+                continue;
+            live -= strlen(far->name) + 1;
+            if (mode < 0)
+                memmove(&ents[0], &ents[1], (n - 1) * sizeof(*ents));
+            n--;
+        }
+        if (used + len > bufsize)
+        {
+            while (live + len > bufsize - bufsize / 4)
+            {
+                dropped = true;
+                struct entry *far = mode < 0 ? &ents[0] : &ents[n - 1];
+                if (n == 0 || (mode < 0 ? compare(&cand, far) <= 0
+                                        : compare(&cand, far) >= 0))
+                    goto next;
+                live -= strlen(far->name) + 1;
+                if (mode < 0)
+                    memmove(&ents[0], &ents[1], (n - 1) * sizeof(*ents));
+                n--;
+            }
+            used = win_compact(ents, n, buf);
+        }
+
+        /* insert sorted */
+        {
+            int lo = 0, hi = n;
+            while (lo < hi)
+            {
+                int mid = (lo + hi) / 2;
+                if (compare(&ents[mid], &cand) <= 0)
+                    lo = mid + 1;
+                else
+                    hi = mid;
+            }
+            memmove(&ents[lo + 1], &ents[lo], (n - lo) * sizeof(*ents));
+            ents[lo] = cand;
+            ents[lo].name = buf + used;
+            memcpy(buf + used, cand.name, len);
+            used += len;
+            live += len;
+            n++;
+        }
+    next:
+        ;
+    }
+    closedir(dir);
+
+    if (n == 0 && mode != 0)
+    {
+        /* nothing there (the directory changed): start over */
+        tree_unlock_cache(c);
+        win.dir = 0;
+        return ft_load_window(c, callback_show_item);
+    }
+
+    bool has_prev = mode == 1 || mode == 2 || (mode == -1 && dropped);
+    bool has_next = mode == -1 || (mode != -1 && dropped);
+    if (has_prev)
+    {
+        memmove(&ents[1], &ents[0], n * sizeof(*ents));
+        ents[0].name = (char *)win_prev_name;
+        ents[0].attr = ATTR_DIRECTORY;
+        ents[0].time_write = 0;
+        n++;
+    }
+    win.prev = has_prev ? 0 : -1;
+    if (has_next)
+    {
+        ents[n].name = (char *)win_next_name;
+        ents[n].attr = ATTR_DIRECTORY;
+        ents[n].time_write = 0;
+        win.next = n++;
+    }
+    else
+        win.next = -1;
+
+    c->dirsindir = 0;
+    for (int i = 0; i < n; i++)
+        if ((ents[i].attr & ATTR_DIRECTORY) && i != win.prev && i != win.next)
+            c->dirsindir++;
+    c->filesindir = c->dirlength = n;
+    c->dirfull = false;
+    c->win_active = true;
+#ifdef YOTON_YM03
+    {
+        extern volatile uint32_t *pager_log;
+        extern volatile uint32_t pager_log_n;
+        if (pager_log)
+        {
+            ((volatile uint32_t *)0x307c00 + 64)[1] = pager_log_n;
+            pager_log = NULL;
+        }
+    }
+    ym03_win_stats[0]++;
+    ym03_win_stats[1] = current_tick - t_start;
+    ym03_win_stats[2] = n;
+    ym03_win_stats[3] = mode;
+    {
+        /* per load: {mode, ticks, entries, flash line reads} at 0x307c00 */
+        extern uint32_t pager_cyc_n;
+        static uint32_t faults0;
+        volatile uint32_t *r = (volatile uint32_t *)0x307c00 + 4 * (ym03_win_stats[0] & 7);
+        r[0] = mode; r[1] = current_tick - t_start; r[2] = n;
+        r[3] = pager_cyc_n - faults0;
+        faults0 = pager_cyc_n;
+    }
+#endif
+    if (win.move)
+    {
+        /* keep the cursor next to where it was */
+        win.move = false;
+        c->selected_item = mode >= 0 ? (win.prev >= 0 ? win.prev + 1 : 0)
+                                     : (win.next >= 0 ? win.next - 1
+                                                         : c->filesindir - 1);
+    }
+    tree_unlock_cache(c);
+    return 0;
+}
+
+/* a wanted file (e.g. the one playing) starts the window */
+static void ft_window_want(struct tree_context *c)
+{
+    if (c->win_want && c->win_want[0])
+    {
+        strmemccpy(win.name, c->win_want, sizeof(win.name));
+        win.attr = filetype_get_attr(win.name);
+        win.time = 0;
+        win.dir = 2;
+    }
+    c->win_want = NULL;
+}
+
+static unsigned win_pl_crc;     /* directory the playlist came from, if a
+                                   window of it */
+static bool win_pl_more;        /* entries follow that window */
+
+static void win_note_playlist(struct tree_context *c)
+{
+    win_pl_crc = c->win_active ? win.crc : 0;
+    win_pl_more = c->win_active && win.next >= 0;
+}
+
+bool ft_window_playlist_has_more(void)
+{
+    return win_pl_crc && win_pl_more && !global_settings.playlist_shuffle;
+}
+
+/*
+ * End of a playlist that was a window of a big directory: make the next
+ * window the playlist and play on. Returns the index to play, or -1.
+ */
+int ft_window_playlist_next(void)
+{
+    struct playlist_info *pl = playlist_get_current();
+    struct playlist_track_info info;
+    if (!win_pl_crc || !win_pl_more || global_settings.playlist_shuffle ||
+        pl->amount <= 0 ||
+        playlist_get_track_info(pl, pl->amount - 1, &info) < 0)
+        return -1;
+
+    /* directory and name of the last track */
+    char dir[MAX_PATH];
+    char *slash = strrchr(info.filename, '/');
+    if (!slash)
+        return -1;
+    size_t dlen = slash - info.filename + 1;
+    if (dlen >= sizeof(dir))
+        return -1;
+    memcpy(dir, info.filename, dlen);
+    dir[dlen] = '\0';
+    if (crc_32(dir, dlen, 0xffffffff) != win_pl_crc)
+        return -1;
+
+    struct tree_context *c = tree_get_context();
+    strmemccpy(c->currdir, dir, sizeof(c->currdir));
+    win.crc = win_pl_crc;
+    win.dir = 1;
+    win.move = false;
+    strmemccpy(win.name, slash + 1, sizeof(win.name));
+    win.attr = filetype_get_attr(win.name);
+    win.time = 0;
+    c->win_active = true;
+    if (ft_load_window(c, NULL) < 0)
+        return -1;
+
+    int index = -1;
+    if (playlist_create(dir, NULL) != -1)
+    {
+        ft_build_playlist(c, 0);
+        if (pl->amount > 0)
+        {
+            index = 0;
+            pl->started = true;
+        }
+    }
+    /* the browser's cache now holds this window */
+    reload_directory();
+    return index;
+}
+
+/* Select on a move entry: load the neighbouring window. Returns true if
+ * the selected entry was one. */
+bool ft_window_move(struct tree_context *c)
+{
+    if (!c->win_active ||
+        (c->selected_item != win.prev && c->selected_item != win.next))
+        return false;
+    bool next = c->selected_item == win.next;
+    struct entry *ref = tree_get_entry_at(c, next ? win.next - 1
+                                                  : win.prev + 1);
+    if (!ref)
+        return false;
+    strmemccpy(win.name, ref->name, sizeof(win.name));
+    win.attr = ref->attr;
+    win.time = ref->time_write;
+    win.dir = next ? 1 : -1;
+    win.move = true;     /* the reload places the cursor */
+    return true;
+}
