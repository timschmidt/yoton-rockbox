diff --git a/firmware/target/arm/system-arm-micro.h b/firmware/target/arm/system-arm-micro.h
index 7659685..3b5fc83 100644
--- a/firmware/target/arm/system-arm-micro.h
+++ b/firmware/target/arm/system-arm-micro.h
@@ -20,10 +20,23 @@
 #ifndef SYSTEM_ARM_MICRO_H
 #define SYSTEM_ARM_MICRO_H
 
+#if CONFIG_CPU == ATJ2157
+/*
+ * The ATJ2157 firmware is demand-paged: MemManage faults (priority 0) must
+ * be taken even inside critical sections. Mask interrupts with BASEPRI
+ * instead of PRIMASK; all interrupts, SysTick, PendSV and SVCall run at
+ * priority IRQ_DISABLED (see system-atj2157.c).
+ */
+#define IRQ_ENABLED         0x00
+#define IRQ_DISABLED        0x80
+#define IRQ_STATUS          0xff
+#define HIGHEST_IRQ_LEVEL   IRQ_DISABLED
+#else
 #define IRQ_ENABLED         0x00
 #define IRQ_DISABLED        0x01
 #define IRQ_STATUS          0x01
 #define HIGHEST_IRQ_LEVEL   IRQ_DISABLED
+#endif
 
 /* For compatibility with ARM classic */
 #define CPU_MODE_THREAD_CONTEXT 0
@@ -42,6 +55,29 @@
            panicf("Incorrect CPU mode in %s (0x%02lx!=0x%02lx)", \
                   __func__, __mproc, __massert); })
 
+#if CONFIG_CPU == ATJ2157
+static inline void enable_irq(void)
+{
+    asm volatile ("msr basepri, %0" :: "r"(IRQ_ENABLED) : "memory");
+}
+
+static inline void disable_irq(void)
+{
+    asm volatile ("msr basepri, %0" :: "r"(IRQ_DISABLED) : "memory");
+}
+
+static inline void restore_irq(int level)
+{
+    asm volatile ("msr basepri, %0" :: "r"(level) : "memory");
+}
+
+static inline int get_irq_level(void)
+{
+    int level;
+    asm volatile ("mrs %0, basepri" : "=r"(level));
+    return level;
+}
+#else
 /* Core-level interrupt masking */
 static inline void enable_irq(void)
 {
@@ -66,6 +102,7 @@ static inline int get_irq_level(void)
 
     return primask;
 }
+#endif
 
 static inline int disable_irq_save(void)
 {
@@ -100,8 +137,19 @@ static inline unsigned long get_interrupt_number(void)
 
 static inline void core_sleep(void)
 {
+#if CONFIG_CPU == ATJ2157
+    /* the watchdog is only fed while the scheduler reaches idle */
+    *(volatile unsigned long *)0xc003001c |= 1;
+    /* WFI does not wake for BASEPRI-masked interrupts: drop to PRIMASK so
+     * a pending interrupt wakes the core and is taken after cpsie. */
+    asm volatile ("cpsid i\n"
+                  "msr basepri, %0\n"
+                  "wfi\n"
+                  "cpsie i\n" :: "r"(0) : "memory");
+#else
     asm volatile ("wfi");
     enable_irq();
+#endif
 }
 
 #endif /* SYSTEM_ARM_MICRO_H */
