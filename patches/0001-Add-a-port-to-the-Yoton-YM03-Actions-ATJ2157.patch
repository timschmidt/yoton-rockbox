diff --git a/firmware/export/config/yotonym03.h b/firmware/export/config/yotonym03.h
new file mode 100644
index 0000000..1b8b2c8
--- /dev/null
+++ b/firmware/export/config/yotonym03.h
@@ -0,0 +1,107 @@
+/*
+ * Yoton YM03 (Actions ATJ2157, Cortex-M4)
+ *
+ * 320 KiB on-chip SRAM in four blocks, 8 MiB SPI NOR (vendor firmware),
+ * 128x128 ST7735S-class LCD on the LCM 8080 bus, microSD slot, LRADC keys.
+ */
+
+/* RoLo-related defines */
+#define MODEL_NAME      "Yoton YM03"
+#define MODEL_NUMBER    134
+#define BOOTFILE_EXT    "ym03"
+#define BOOTFILE        "rockbox." BOOTFILE_EXT
+#define BOOTDIR         "/.rockbox"
+
+/* CPU defines */
+#define CONFIG_CPU          ATJ2157
+#define CPU_FREQ            48000000 /* core clock left by the boot ROM (measured) */
+
+/* Kernel defines */
+#define INCLUDE_TIMEOUT_API
+#define HAVE_SEMAPHORE_OBJECTS
+
+/* Buffer for plugins and codecs. */
+#define PLUGIN_BUFFER_SIZE  0x1000
+#define CODEC_SIZE          0x5C00   /* PCM codecs, or the built-in MP3
+                                          decoder's state, scratch and
+                                          output (with the plugin buffer) */
+/* plugins load into the codec area + plugin buffer (playback is stopped
+ * for them): the 4 KiB plugin buffer alone fits no plugin */
+#define PLUGIN_IN_CODEC_AREA
+
+/* MP3 through the built-in minimp3 decoder (apps/codec_builtin_mp3.c) */
+#define HAVE_BUILTIN_MINIMP3
+
+/* long UI operations give the codec a chance once per tick (list drawing,
+ * screen updates, directory loading): the PCM buffer only lasts ~90 ms.
+ * Only where no pointer into movable (buflib) memory is held. */
+#ifndef BOOTLOADER
+#define UI_YIELD_POINT()    atj_yield_point()   /* system-target.h */
+#endif
+
+/* LCD defines */
+#define CONFIG_LCD          LCD_YOTON_YM03
+#define LCD_WIDTH           128
+#define LCD_HEIGHT          128
+#define LCD_DEPTH           16
