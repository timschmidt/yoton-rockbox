+ * NOTE: This file must be included from system-arm-micro.c!
+ */
+void usb_irq_handler(void) ATTR_IRQ_HANDLER;
+void dma_irq_handler(void) ATTR_IRQ_HANDLER;
+void timer_irq_handler(void) ATTR_IRQ_HANDLER;
diff --git a/firmware/target/arm/atj2157/pager-atj2157.c b/firmware/target/arm/atj2157/pager-atj2157.c
new file mode 100644
index 0000000..ce3414c
--- /dev/null
+++ b/firmware/target/arm/atj2157/pager-atj2157.c
@@ -0,0 +1,557 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * Demand pager for the ATJ2157 (Cortex-M4, no MMU, 320 KiB SRAM).
+ *
+ * The 32 KiB SRAM2 and SRAM3 blocks are aliased every 32 KiB across 1 MiB
+ * windows (0x200000 and 0x300000). Address bits [14:13] pick an 8 KiB
+ * physical slot, the upper bits are ignored by the hardware. The linker
+ * places each 8 KiB page of non-resident code at a distinct alias of the
+ * slot it is meant to occupy (tools/ym03_pagelink.py):
+ *
+ *   code page p   : VA 0x200000 + (p >> 2)*0x8000 + (p & 3)*0x2000  (4 slots)
+ *   rodata page q : VA 0x340000 + (q >> 1)*0x8000 + (q & 1)*0x2000  (2 slots)
+ *
+ * Pages are cached in 1 KiB lines: line k of slot s holds 1 KiB k of some
+ * page that maps to slot s. Pages that map to the same slot can be mapped
+ * at the same time as long as they use different lines. MPU region 0
+ * denies both windows (except 0x300000-0x33ffff: SRAM3 as RAM); regions
+ * 1-7 are a pool, each mapping one page with only its loaded lines enabled
+ * (sub-regions). Touching anything else raises MemManage; the handler reads
+ * the 1 KiB from SPI NOR, takes the line from the page that had it, maps
+ * the page (reusing the least recently faulted region if needed) and
+ * returns, so the access is retried.
+ * This works for instruction fetches, data reads, calls, returns and
+ * function pointers alike. The rodata window skips its first 128 KiB
+ * subregion so SRAM3 slots 2-3 (0x304000-0x307fff) stay usable as RAM.
+ *
+ * Everything in this file must be resident and must not call out.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#include "config.h"
+#include "system.h"
+#include "pager-atj2157.h"
+
+#define REG(a)          (*(volatile uint32_t *)(a))
+#define SCB_SHCSR       REG(0xe000ed24)
+#define SCB_CFSR        REG(0xe000ed28)
+#define SCB_MMFAR       REG(0xe000ed34)
+#define MPU_CTRL        REG(0xe000ed94)
+#define MPU_RNR         REG(0xe000ed98)
+#define MPU_RBAR        REG(0xe000ed9c)
+#define MPU_RASR        REG(0xe000eda0)
+
+#define PAGE_SIZE       0x2000
+#define CODE_WIN        0x200000
+#define RO_WIN          0x340000
+#define RO_WIN_END      0x400000
+#define CODE_SLOTS      4
+#define RO_SLOTS        2
+
+#define RASR(size_log2, ap, xn, srd) \
+    (((xn) << 28) | ((ap) << 24) | ((srd) << 8) | (((size_log2) - 1) << 1) | 1)
+
+/* SPI0 (NOR) */
+#define SPI_CTL         REG(0xc00a0000)
+#define SPI_STAT        REG(0xc00a0004)
+#define SPI_TX          REG(0xc00a0008)
+#define SPI_RX          REG(0xc00a000c)
+#define SPI_BC          REG(0xc00a0010)
+
+struct pager_stats pager_stats;
+/* page read timing (CPU cycles) */
+uint32_t pager_cyc_total, pager_cyc_max, pager_cyc_n;
+bool pager_dma_used;
+static uint32_t pager_base;        /* NOR address of the first code page */
+static uint32_t pager_ncode;       /* number of code pages */
+static uint32_t pager_nro;
+/* 1 KiB lines (MPU sub-regions); a fault reads one: ~0.18 ms at 48 MHz */
+#define SUB_SIZE        (PAGE_SIZE / 8)
+#define NREG            7                   /* MPU regions 1..7 */
+#define NO_PAGE         0xffffffffu
+static uint32_t reg_page[NREG];             /* code p or 0x100 + rodata q */
+static uint32_t reg_va[NREG];
+static uint32_t reg_lru[NREG], lru_clock;
+static uint8_t  reg_mask[NREG];             /* lines loaded (sub-regions) */
+static uint8_t  reg_slot[NREG];             /* physical slot (lines/8) */
+/* page whose data each physical line holds (it outlives the mapping: a
+ * page whose region was reused gets its intact lines back without a read) */
+static uint32_t line_page[(CODE_SLOTS + RO_SLOTS) * 8];
+uint32_t pager_remaps;
+
+static int spi_wait(uint32_t mask, uint32_t val)
+{
+    for (int i = 0; i < 200000; i++)
+        if ((SPI_STAT & mask) == val)
+            return 0;
+    return 1;
+}
+
+static inline void spi_mode(int m) { SPI_CTL = (SPI_CTL & ~3) | m; }
+
+static int nor_read(uint32_t addr, uint8_t *dst, uint32_t len)
+{
+    const uint8_t cmd[4] = { 0x03, addr >> 16, addr >> 8, addr };
+    int err = 0;
+
+    SPI_CTL |= 8; SPI_CTL &= ~8;                /* CS low */
+    spi_mode(0); spi_mode(2);
+    for (int i = 0; i < 4; i++)
+        SPI_TX = cmd[i];
+    err |= spi_wait(0x10, 0x10);
+    err |= spi_wait(0x40, 0);
+    spi_mode(0);
+    while (len)
+    {
+        uint32_t c = len > 0x1000 ? 0x1000 : len;
+        SPI_CTL &= ~0x30; SPI_CTL |= 0x30;
+        SPI_BC = c;
+        spi_mode(1);
+        for (uint32_t i = 0; i < c; i++)
+        {
+            err |= spi_wait(4, 0);
+            *dst++ = SPI_RX;
+        }
+        spi_mode(0);
+        len -= c;
+    }
+    SPI_CTL |= 8;                               /* CS high */
+    return err;
+}
+
+/*
+ * Fast path, as the mask ROM reads NOR (0x2224): FAST READ (0x0B) with the
+ * SPI RX FIFO drained by DMA channel 0 (mode 0x00200088), SPI clock 48 MHz
+ * (CMU+0x20 = 0x200; measured 1.37 ms per 8 KiB page against 6.5 ms for
+ * the byte-polled read). Destinations in SRAM2/SRAM3 go through their DMA
+ * aliases.
+ */
+#define DMA0(o)         REG(0xc0070100 + (o))
+#define CMU_SPICLK      REG(0xc0001020)
+static bool nor_dma_ok;
+
+/* Called while a page read is in flight, if the faulting code ran where an
+ * interrupt of normal priority could have been taken (thread mode, nothing
+ * masked): lets the audio DMA be refilled during a burst of page faults. */
+void (*pager_poll_hook)(void);
+static bool pager_poll_ok;
+
+static uint32_t dma_addr(const void *p)
+{
+    uint32_t a = (uint32_t)p;
+    if (a >= 0x200000 && a < 0x300000)
+        return 0x10000000 + (a & 0x7fff);
+    if (a >= 0x300000 && a < 0x400000)
+        return 0x18000000 + (a & 0x7fff);
+    return a;
+}
+
+static int nor_read_dma(uint32_t addr, uint8_t *dst, uint32_t len)
+{
+    int err = 0;
+
+    SPI_CTL |= 8; SPI_CTL &= ~8;                /* CS low */
+    spi_mode(0); spi_mode(2);
+    SPI_TX = 0x0b;
+    SPI_TX = addr >> 16;
+    SPI_TX = addr >> 8;
+    SPI_TX = addr;
+    SPI_TX = 0;                                 /* dummy cycle byte */
+    err |= spi_wait(0x40, 0);
+    err |= spi_wait(0x10, 0x10);
+    SPI_BC = len;
+    DMA0(0x08) = (uint32_t)&SPI_RX;
+    DMA0(0x10) = dma_addr(dst);
+    DMA0(0x18) = len;
+    DMA0(0x00) = 0x00200088;                    /* SPI RX -> memory */
+    spi_mode(0);
+    SPI_CTL &= ~0x30; SPI_CTL |= 0x30;          /* FIFO reset */
+    SPI_CTL |= 0x80000040;                      /* SPI DMA request */
+    DMA0(0x04) = 1;
+    spi_mode(1);
+    int t;
+    for (t = 0; t < 2000000 && (DMA0(0x04) & 1); t++)
+        if (pager_poll_ok && pager_poll_hook)
+            pager_poll_hook();
+    if (t >= 2000000)
+    {
+        DMA0(0x04) = 0;
+        err |= 2;
+    }
+    SPI_CTL |= 8;                               /* CS high */
+    SPI_CTL &= 0x7fffefbc;
+    return err;
+}
+
+static void nor_cmd(uint8_t c)
+{
+    SPI_CTL |= 8; SPI_CTL &= ~8;
+    spi_mode(0); spi_mode(2);
+    SPI_TX = c;
+    spi_wait(0x10, 0x10);
+    spi_wait(0x40, 0);
+    spi_mode(0);
+    SPI_CTL |= 8;
+}
+
+/* SPI0 bring-up, as done by the boot ROM (0x337c / 0x383c group 0) */
+static void nor_init(void)
+{
+    REG(0xc0001020) = (REG(0xc0001020) & ~0x3ffu) | 0x101;  /* SPI0 clock */
+    REG(0xc0001008) |= 1 << 6;                              /* clock on */
+    REG(0xc0000000) &= ~(1u << 6);
+    REG(0xc0000000) |= 1 << 6;                              /* reset */
+    SPI_CTL = 0x00080138;
+    for (int pin = 12; pin <= 15; pin++)
+        REG(0xc01c0004 + 4 * pin) = 0x3027;                 /* SPI0 pins */
+    nor_cmd(0xab);                                          /* release PD */
+    for (volatile int i = 0; i < 20000; i++);
+    nor_cmd(0xff);                                          /* exit cont. read */
+    /* the first transaction after this sequence is dropped: burn one */
+    uint8_t id[4];
+    nor_read(0, id, 4);
+}
+
+static void mpu_set(int n, uint32_t base, uint32_t rasr)
+{
+    MPU_RNR = n;
+    MPU_RBAR = base;
+    MPU_RASR = rasr;
+}
+
+int pager_init(uint32_t nor_store)
+{
+    uint32_t hdr[4];
+
+    nor_init();
+    for (int tries = 0; ; tries++)
+    {
+        if (nor_read(nor_store, (uint8_t *)hdr, sizeof(hdr)) == 0 &&
+            hdr[0] == PAGER_MAGIC)
+            break;
+        if (tries == 4)
+        {
+            ATJ_TRACE[TR_HDR0] = hdr[0];
+            ATJ_TRACE[TR_HDR1] = hdr[1];
+            return -2;
+        }
+    }
+    ATJ_TRACE[TR_HDR0] = hdr[0];
+    ATJ_TRACE[TR_HDR1] = hdr[1];
+    ATJ_TRACE[TR_HDR2] = hdr[2];
+    pager_ncode = hdr[1];
+    pager_nro = hdr[2];
+    pager_base = nor_store + PAGE_SIZE;
+
+    /* Fast page reads: SPI clock 0x301 (~96 MHz) or 0x200 (48 MHz) with DMA,
+     * taking the first that reads two whole pages exactly like the
+     * byte-polled read at the boot ROM's clock; else stay byte-polled.
+     * Code slot 0 (SRAM2, not mapped yet) is the scratch area; no library
+     * calls here: they may live in pages that are not mapped yet. */
+    {
+        static const uint16_t clocks[] = { 0x301, 0x200 };
+        uint32_t old = CMU_SPICLK;
+        volatile uint32_t *slot = (volatile uint32_t *)0x200000;
+        uint32_t ref[2];
+        for (int p = 0; p < 2; p++)
+        {
+            uint32_t sum = 0;
+            nor_read(pager_base + p * 7 * PAGE_SIZE, (uint8_t *)slot, PAGE_SIZE);
+            for (int i = 0; i < PAGE_SIZE / 4; i++)
+                sum = sum * 31 + slot[i];
+            ref[p] = sum;
+        }
+        nor_dma_ok = false;
+        for (unsigned c = 0; c < sizeof(clocks) / sizeof(clocks[0]) && !nor_dma_ok; c++)
+        {
+            CMU_SPICLK = (old & ~0x3ffu) | clocks[c];
+            bool ok = true;
+            for (int p = 0; p < 2 && ok; p++)
+            {
+                uint32_t sum = 0;
+                for (int i = 0; i < PAGE_SIZE / 4; i++)
+                    slot[i] = 0x5a5a5a5a;
+                if (nor_read_dma(pager_base + p * 7 * PAGE_SIZE, (uint8_t *)slot, PAGE_SIZE))
+                    ok = false;
+                for (int i = 0; i < PAGE_SIZE / 4; i++)
+                    sum = sum * 31 + slot[i];
+                if (sum != ref[p])
+                    ok = false;
+            }
+            nor_dma_ok = ok;
+        }
+        if (!nor_dma_ok)
+            CMU_SPICLK = old;
+        ATJ_TRACE[TR_FREE + 6] = CMU_SPICLK;
+        pager_dma_used = nor_dma_ok;
+    }
+
+    for (int i = 0; i < NREG; i++)
+        reg_page[i] = NO_PAGE;
+    for (unsigned i = 0; i < sizeof(line_page) / sizeof(line_page[0]); i++)
+        line_page[i] = NO_PAGE;
+
+    MPU_CTRL = 0;
+    /* deny 0x200000-0x3fffff; sub-region 4 (0x300000-0x33ffff) disabled so
+     * SRAM3 stays plain RAM there */
+    mpu_set(0, CODE_WIN, RASR(21, 0, 1, 0x10));
+    for (int n = 1; n < 8; n++)
+        mpu_set(n, 0, 0);                                   /* pool empty */
+    MPU_CTRL = 5;                                           /* EN | PRIVDEFENA */
+    asm volatile ("dsb; isb");
+
+    SCB_SHCSR |= 1 << 16;                                   /* MEMFAULTENA */
+    return 0;
+}
+
+/* Called from memmanage_handler (assembly entry) with the exception frame. */
+uint16_t pager_page_faults[128];
+/* optional fault-address log (host test mode points it at spare RAM) */
+volatile uint32_t *pager_log;
+volatile uint32_t pager_log_n, pager_log_max;
+volatile int pager_log_ro_only;     /* 1: rodata faults, 2: all, as a ring */
+#ifdef YM03_PAGER_PROFILE
+/* fault addresses while profiling is on */
+uint32_t pager_profile[256];
+uint32_t pager_profile_n;
+volatile bool pager_profile_on;
+#endif
+
+void pager_fault(uint32_t *frame)
+{
+    uint32_t cfsr = SCB_CFSR;
+    uint32_t addr = (cfsr & 0x80) ? SCB_MMFAR : frame[6];
+    {
+        uint32_t basepri, primask;
+        asm volatile ("mrs %0, basepri" : "=r" (basepri));
+        asm volatile ("mrs %0, primask" : "=r" (primask));
+        /* stacked xPSR exception number 0: the fault came from thread mode */
+        pager_poll_ok = (frame[7] & 0x1ff) == 0 && basepri == 0 && primask == 0;
+    }
+    {
+        /* first faults after boot: {addr, pc, lr} for bring-up debugging */
+        uint32_t k = ATJ_TRACE[TR_FREE + 20];
+        if (k < 8)
+        {
+            ATJ_TRACE[TR_FREE + 21 + 3 * k] = addr;
+            ATJ_TRACE[TR_FREE + 22 + 3 * k] = frame[6];
+            ATJ_TRACE[TR_FREE + 23 + 3 * k] = frame[5];
+            ATJ_TRACE[TR_FREE + 20] = k + 1;
+        }
+    }
+    SCB_CFSR = cfsr & 0xff;                                 /* clear MMFSR */
+
+    uint32_t nor, slot, region, phys, va, sidx, spage, xn;
+    if (addr >= CODE_WIN && addr < CODE_WIN + 0x100000)
+    {
+        uint32_t off = addr - CODE_WIN;
+        uint32_t page = ((off >> 15) << 2) | ((off >> 13) & 3);
+        if (page >= pager_ncode)
+            goto fatal;
+        slot = page & 3;
+        phys = 0x200000 + slot * PAGE_SIZE;
+        va = addr & ~(PAGE_SIZE - 1);
+        nor = pager_base + page * PAGE_SIZE;
+        sidx = slot;
+        spage = page;
+        xn = 0;
+        pager_stats.code_faults++;
+        if (page < 64)
+            pager_page_faults[page]++;
+        ATJ_TRACE[TR_CODE_FAULTS] = pager_stats.code_faults;
+    }
+    else if (addr >= RO_WIN && addr < RO_WIN_END)
+    {
+        uint32_t off = addr - RO_WIN;
+        uint32_t page = ((off >> 15) << 1) | ((off >> 13) & 1);
+        if (page >= pager_nro)
+            goto fatal;
+        slot = page & 1;
+        phys = 0x300000 + slot * PAGE_SIZE;
+        va = addr & ~(PAGE_SIZE - 1);
+        nor = pager_base + (pager_ncode + page) * PAGE_SIZE;
+        sidx = CODE_SLOTS + slot;
+        spage = 0x100 + page;
+        xn = 1;
+        pager_stats.ro_faults++;
+        if (page < 64)
+            pager_page_faults[64 + page]++;
+        ATJ_TRACE[TR_RO_FAULTS] = pager_stats.ro_faults;
+    }
+    else
+        goto fatal;
+
+    uint32_t sub = (addr >> 10) & 7;
+    int r = -1;
+    bool fresh = false;
+    for (int i = 0; i < NREG; i++)
+        if (reg_page[i] == spage)
+            r = i;
+    if (r < 0)
+    {
+        /* a free region, else the least recently faulted one that does not
+         * map the code that faulted */
+        uint32_t pc = frame[6], pcpage = NO_PAGE;
+        if (pc >= CODE_WIN && pc < CODE_WIN + 0x100000)
+        {
+            uint32_t o = pc - CODE_WIN;
+            pcpage = ((o >> 15) << 2) | ((o >> 13) & 3);
+        }
+        uint32_t best = 0xffffffffu;
+        for (int i = 0; i < NREG; i++)
+        {
+            if (reg_page[i] == NO_PAGE)
+            {
+                r = i;
+                break;
+            }
+            if (reg_page[i] != pcpage && reg_lru[i] < best)
+            {
+                best = reg_lru[i];
+                r = i;
+            }
+        }
+        reg_page[r] = spage;
+        reg_va[r] = va;
+        reg_slot[r] = sidx;
+        /* lines still holding this page's data come back as they are */
+        reg_mask[r] = 0;
+        for (int k = 0; k < 8; k++)
+            if (line_page[sidx * 8 + k] == spage)
+                reg_mask[r] |= 1u << k;
+        fresh = true;
+    }
+    if (reg_mask[r] & (1u << sub))
+    {
+        if (!fresh)
+        {
+            /* an access straddling into the next line (32-bit instruction,
+             * unaligned or multiple load) reports its start */
+            if (sub == 7 || (reg_mask[r] & (2u << sub)))
+                goto fatal;                                 /* not a paging fault */
+            sub++;
+            if (line_page[sidx * 8 + sub] == spage)
+                reg_mask[r] |= 1u << sub;
+        }
+        if (reg_mask[r] & (1u << sub))
+        {
+            /* mapping only: the data is there */
+            pager_remaps++;
+            reg_lru[r] = ++lru_clock;
+            MPU_CTRL = 0;
+            asm volatile ("dsb; isb");
+            mpu_set(1 + r, va, RASR(13, 3, xn, ~reg_mask[r] & 0xff));
+            MPU_CTRL = 5;
+            asm volatile ("dsb; isb");
+            return;
+        }
+    }
+    region = 1 + r;
+    ATJ_TRACE[TR_LAST_ADDR] = addr;
+    if (pager_log && pager_log_ro_only && (xn || pager_log_ro_only == 2))
+    {
+        /* ring of {addr, pc}; pager_log_n counts all */
+        uint32_t i = (pager_log_n * 2) % pager_log_max;
+        pager_log[i] = addr;
+        pager_log[i + 1] = frame[6];
+        pager_log_n++;
+    }
+    else if (pager_log && !pager_log_ro_only && pager_log_n + 1 < pager_log_max)
+    {
+        /* {fault address, faulting pc} */
+        pager_log[pager_log_n++] = addr;
+        pager_log[pager_log_n++] = frame[6];
+    }
+#ifdef YM03_PAGER_PROFILE
+    if (pager_profile_on && pager_profile_n < 256)
+        pager_profile[pager_profile_n++] = addr;
+#endif
+    /* serving a fault is forward progress: keep the watchdog quiet */
+    REG(0xc003001c) |= 1;
+    /*
+     * Fill the slot through its physical alias. That alias lies inside the
+     * denied window and the MPU applies to this handler too, so switch the
+     * MPU off while copying (nothing else runs: we are the highest priority).
+     */
+    MPU_CTRL = 0;
+    asm volatile ("dsb; isb");
+    {
+        /* take the physical line from the page whose data it holds; if that
+         * page is mapped, unmap the line */
+        uint32_t q = line_page[sidx * 8 + sub];
+        for (int o = 0; o < NREG; o++)
+        {
+            if (o != r && q != NO_PAGE && reg_page[o] == q &&
+                (reg_mask[o] & (1u << sub)))
+            {
+                reg_mask[o] &= ~(1u << sub);
+                mpu_set(1 + o, reg_va[o],
+                        RASR(13, 3, q >= 0x100, ~reg_mask[o] & 0xff));
+            }
+        }
+        line_page[sidx * 8 + sub] = NO_PAGE;
+    }
+    /* SysTick counts down CPU cycles, reloading every tick (the DWT cycle
+     * counter does not run on this part) */
+    uint32_t c0 = REG(0xe000e018);
+    nor += sub * SUB_SIZE;
+    phys += sub * SUB_SIZE;
+    int err = nor_dma_ok ? nor_read_dma(nor, (uint8_t *)phys, SUB_SIZE)
+                         : nor_read(nor, (uint8_t *)phys, SUB_SIZE);
+    uint32_t c1 = REG(0xe000e018);
+    uint32_t dc = c0 >= c1 ? c0 - c1 : c0 + (REG(0xe000e014) + 1) - c1;
+    pager_cyc_total += dc;
+    pager_cyc_n++;
+    if (dc > pager_cyc_max)
+        pager_cyc_max = dc;
+    line_page[sidx * 8 + sub] = spage;
+    reg_mask[r] |= 1u << sub;
+    reg_lru[r] = ++lru_clock;
+    /* SRD bit set = sub-region disabled (falls through to the deny region) */
+    mpu_set(region, va, RASR(13, 3, xn, ~reg_mask[r] & 0xff));
+    MPU_CTRL = 5;
+    asm volatile ("dsb; isb");
+    if (err)
+        goto fatal;
+    return;
+
+fatal:
+    ATJ_TRACE[TR_BAD_ADDR] = addr;
+    ATJ_TRACE[TR_BAD_PC] = frame[6];
+    ATJ_TRACE[TR_BAD_CFSR] = cfsr;
+    pager_stats.last_bad_addr = addr;
+    pager_stats.last_bad_cfsr = cfsr;
+    pager_stats.last_bad_pc = frame[6];
+    /* the panic runs in the interrupted context with paging intact */
+    pager_bad_fault(frame);
+}
+
+/* Exception entry: pass the frame of whichever stack was active. */
+asm (
+    "    .syntax unified\n"
+    "    .thumb\n"
+    "    .section .text.memmanage_handler,\"ax\",%progbits\n"
+    "    .global memmanage_handler\n"
+    "    .thumb_func\n"
+    "memmanage_handler:\n"
+    "    tst     lr, #4\n"
+    "    ite     eq\n"
+    "    mrseq   r0, msp\n"
+    "    mrsne   r0, psp\n"
+    "    push    {r4, lr}\n"
+    "    bl      pager_fault\n"
+    "    pop     {r4, pc}\n"
+);
diff --git a/firmware/target/arm/atj2157/pager-atj2157.h b/firmware/target/arm/atj2157/pager-atj2157.h
new file mode 100644
index 0000000..e082945
--- /dev/null
+++ b/firmware/target/arm/atj2157/pager-atj2157.h
@@ -0,0 +1,64 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#ifndef __PAGER_ATJ2157_H__
+#define __PAGER_ATJ2157_H__
+
+#include <stdint.h>
+
+/* Page store: header page ("YMPG", ncode, nro, checksum) then code pages,
+ * then rodata pages, 8 KiB each. Lives in the free part of the SPI NOR. */
+#define PAGER_MAGIC         0x47504d59      /* "YMPG" */
+#define PAGER_NOR_STORE     0x00762000  /* up to 0x7cc000 (resident image) */
+
+/* Boot/debug trace in the last 256 bytes of SRAM1 (bottom framebuffer
+ * rows). The stock firmware leaves that RAM alone, so it can be read back
+ * over ADFU after a reset. */
+#define ATJ_TRACE           ((volatile uint32_t *)0x0015ff00)
+#define ATJ_TRACE_MAGIC     0x45434154      /* "TACE" */
+enum {
+    TR_MAGIC = 0, TR_STAGE, TR_PAGER_RC, TR_HDR0, TR_HDR1, TR_HDR2,
+    TR_CODE_FAULTS, TR_RO_FAULTS, TR_LAST_ADDR, TR_BAD_ADDR, TR_BAD_PC,
+    TR_BAD_CFSR, TR_PANIC_PC, TR_FREE
+};
+
+struct pager_stats
+{
+    uint32_t code_faults;
+    uint32_t ro_faults;
+    uint32_t last_bad_addr;
+    uint32_t last_bad_cfsr;
+    uint32_t last_bad_pc;
+};
+
+extern struct pager_stats pager_stats;
+/* faults per page: code pages 0..63, rodata pages 64..127 */
+extern uint16_t pager_page_faults[128];
+/* #define YM03_PAGER_PROFILE */
+#ifdef YM03_PAGER_PROFILE
+extern uint32_t pager_profile[256];
+extern uint32_t pager_profile_n;
+extern volatile bool pager_profile_on;
+#endif
+
+/* Returns 0 on success, <0 if the page store is missing/unreadable. */
+int pager_init(uint32_t nor_store);
+
+/* Provided by the system code: a MemManage fault the pager can't serve. */
+void pager_bad_fault(uint32_t *frame);
+
+#endif /* __PAGER_ATJ2157_H__ */
diff --git a/firmware/target/arm/atj2157/system-atj2157.c b/firmware/target/arm/atj2157/system-atj2157.c
new file mode 100644
index 0000000..a4a5ab7
--- /dev/null
+++ b/firmware/target/arm/atj2157/system-atj2157.c
@@ -0,0 +1,380 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * ATJ2157 system support: SysTick based tick and delays, reset, watchdog.
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#include "system.h"
+#include "kernel.h"
+#include "tick.h"
+#include "button.h"
+#include "regs/cortex-m/cm_scb.h"
+#include "regs/cortex-m/cm_systick.h"
+#ifndef BOOTLOADER
+#include "pager-atj2157.h"
+#include "panic.h"
+#endif
+
+#ifndef BOOTLOADER
+/* Development test mode: the loader leaves this magic in the (unzeroed)
+ * plugin buffer; the firmware then reboots by itself after 30 s. */
+#define ATJ_TESTMODE_MAGIC_ADDR (*(volatile uint32_t *)0x00137ff0)
+#define ATJ_TESTMODE_MAGIC      0x54535459  /* "YTST": cable ignored */
+#define ATJ_TESTMODE_USB_MAGIC  0x42535559  /* "YUSB": USB mode allowed */
+static bool atj_testmode, atj_test_usb;
+
+/* host USB test run: let the USB stack see the cable */
+bool atj_test_usb_allowed(void)
+{
+    return atj_test_usb;
+}
+
+/* boot loaded by the host test tool (tools/ym03_maintest.py) */
+bool atj_is_testmode(void)
+{
+    return atj_testmode;
+}
+#endif
+
+/* SysTick runs from the core clock */
+#define SYSTICK_PER_MS  (CPU_FREQ / 1000)
+
+static uint32_t systick_interval_in_ms = 1000 / HZ;
+
+void commit_discard_idcache(void) {}
+void commit_discard_dcache(void) {}
+void commit_dcache(void) {}
+void discard_dcache_range(const void *base, unsigned int size) { (void)base; (void)size; }
+void commit_dcache_range(const void *base, unsigned int size) { (void)base; (void)size; }
+
+void atj_module_enable(uint32_t rst_bit, uint32_t clk_bit)
+{
+    CMU_CLKEN0 |= clk_bit;
+    RMU_RST0 &= ~rst_bit;
+    udelay(10);
+    RMU_RST0 |= rst_bit;
+}
+
+static void systick_start(void)
+{
+    reg_writef(CM_SYSTICK_RVR, VALUE(SYSTICK_PER_MS * systick_interval_in_ms - 1));
+    reg_writef(CM_SYSTICK_CVR, VALUE(0));
+    reg_writef(CM_SYSTICK_CSR, CLKSOURCE(1), ENABLE(1));
+}
+
+/*
+ * Exception priorities: faults (MemManage/BusFault/UsageFault) at 0 so the
+ * pager can run anywhere; everything else at IRQ_DISABLED (0x80) so that
+ * BASEPRI masking covers it.
+ */
+static void atj_set_priorities(void)
+{
+    *(volatile uint32_t *)0xe000ed18 = 0x00000000;   /* MemManage/Bus/Usage */
+    *(volatile uint32_t *)0xe000ed1c = 0x80000000;   /* SVCall */
+    *(volatile uint32_t *)0xe000ed20 = 0x80800000;   /* PendSV, SysTick */
+    for (int i = 0; i < 16; i++)
+        ((volatile uint32_t *)0xe000e400)[i] = 0x80808080;
+}
+
+#ifndef BOOTLOADER
+/*
+ * The boot ROM's USB recovery mode runs this (ROM 0x23c4) before anything
+ * else; a cold NOR boot through our stub does not. Every part of this port
+ * was brought up in the state it leaves, so recreate it: PMU bits 29/28
+ * (USB/VBUS power), 0xc0000114, the system clock setting CMU+0 = 0x03000002,
+ * clock gates CMU+8 |= 0x8001 and the bus-master memory enables
+ * 0xc0040004 |= 0xff.
+ */
+static void atj_rom_usb_clock_setup(void)
+{
+    volatile uint32_t *pmu0 = (volatile uint32_t *)0xc0010000;
+    *pmu0 |= 1u << 29;
+    for (volatile int i = 0; i < 500; i++);
+    *pmu0 |= 1u << 28;
+    *(volatile uint32_t *)0xc0000114 = 0x88;
+    for (volatile int i = 0; i < 50000; i++);
+    *(volatile uint32_t *)0xc0001000 = 0x03000002;
+    *(volatile uint32_t *)0xc0001008 |= 0x8001;
+    *(volatile uint32_t *)0xc0040004 |= 0xff;
+}
+
+void atj_pager_early_init(void)
+{
+    atj_rom_usb_clock_setup();
+    /* FPU (CP10/CP11) full access; used by the built-in MP3 decoder only.
+     * Lazy FP stacking (FPCCR reset default) keeps interrupts cheap. */
+    *(volatile uint32_t *)0xe000ed88 |= 0xfu << 20;
+    asm volatile ("dsb\n isb" ::: "memory");
+    for (int i = 0; i < 64; i++)
+        ATJ_TRACE[i] = 0;
+    ATJ_TRACE[TR_MAGIC] = ATJ_TRACE_MAGIC;
+    ATJ_TRACE[TR_STAGE] = 1;
+    atj_set_priorities();
+    int rc = pager_init(PAGER_NOR_STORE);
+    if (*(volatile uint32_t *)0x137fe8 == 0x524c4146 &&      /* "FALR" */
+        *(volatile uint32_t *)0x137ff0 == 0x54535459)       /* test mode */
+    {
+        /* host test: rodata faults {addr, pc} from boot at 0x307c00 */
+        extern volatile uint32_t *pager_log;
+        extern volatile uint32_t pager_log_n, pager_log_max;
+        extern volatile int pager_log_ro_only;
+        volatile uint32_t *h = (volatile uint32_t *)0x307c00;
+        h[0] = 0x46525059;
+        pager_log_n = 0;
+        pager_log_max = 254;
+        pager_log_ro_only = true;
+        pager_log = &h[2];
+    }
+    ATJ_TRACE[TR_PAGER_RC] = rc;
+    ATJ_TRACE[TR_STAGE] = 2;
+    if (rc < 0)
+    {
+        /* no page store: nothing can run. Let the watchdog reset us. */
+        while (1);
+    }
+}
+
+#endif /* !BOOTLOADER */
+
+/*
+ * Fatal faults. The panic screen needs paged code (fonts, lcd_puts, printf),
+ * which can not be paged in from inside a fault handler, so the handler
+ * only records the fault and makes the exception return into
+ * atj_fault_panic() in the interrupted context; the panic then runs with
+ * demand paging working and reboots as usual.
+ */
+static struct
+{
+    const char *what;
+    uint32_t pc, lr, cfsr, hfsr, addr;
+} atj_fault;
+
+static void __attribute__((noreturn, used)) atj_fault_panic(void)
+{
+    panicf("%s pc %08lx lr %08lx cfsr %08lx hfsr %08lx addr %08lx",
+           atj_fault.what, (unsigned long)atj_fault.pc,
+           (unsigned long)atj_fault.lr, (unsigned long)atj_fault.cfsr,
+           (unsigned long)atj_fault.hfsr, (unsigned long)atj_fault.addr);
+    while (1);
+}
+
+static void atj_fault_redirect(uint32_t *frame, const char *what,
+                               uint32_t addr)
+{
+    if (atj_fault.what)
+    {
+        /* faulted again while getting to the panic: just reset */
+        system_reboot();
+    }
+    atj_fault.what = what;
+    atj_fault.pc = frame[6];
+    atj_fault.lr = frame[5];
+    atj_fault.cfsr = ATJ_REG(0xe000ed28);
+    atj_fault.hfsr = ATJ_REG(0xe000ed2c);
+    atj_fault.addr = addr;
+    ATJ_REG(0xe000ed28) = atj_fault.cfsr;       /* clear (W1C) */
+    ATJ_REG(0xe000ed2c) = atj_fault.hfsr;
+    frame[6] = (uint32_t)atj_fault_panic & ~1u;
+    frame[7] = 0x01000000;                      /* Thumb, no IT state */
+}
+
+void atj_fault_c(uint32_t *frame, uint32_t exc)
+{
+    static const char * const names[] = {
+        [3] = "HardFault", [5] = "BusFault", [6] = "UsageFault",
+    };
+    uint32_t addr = 0;
+    if (exc == 5)
+        addr = ATJ_REG(0xe000ed38);             /* BFAR */
+    atj_fault_redirect(frame, exc < 7 && names[exc] ? names[exc] : "Fault",
+                       addr);
+}
+
+asm (
+    "    .syntax unified\n"
+    "    .thumb\n"
+    "    .section .text.atj_fault_entry,\"ax\",%progbits\n"
+    "    .global hardfault_handler\n"
+    "    .global busfault_handler\n"
+    "    .global usagefault_handler\n"
+    "    .thumb_func\n"
+    "hardfault_handler:\n"
+    "    .thumb_func\n"
+    "busfault_handler:\n"
+    "    .thumb_func\n"
+    "usagefault_handler:\n"
+    "    tst     lr, #4\n"
+    "    ite     eq\n"
+    "    mrseq   r0, msp\n"
+    "    mrsne   r0, psp\n"
+    "    mrs     r1, ipsr\n"
+    "    push    {r4, lr}\n"
+    "    bl      atj_fault_c\n"
+    "    pop     {r4, pc}\n"
+);
+
+#ifndef BOOTLOADER
+void pager_bad_fault(uint32_t *frame)
+{
+    atj_fault_redirect(frame, "MemManage", pager_stats.last_bad_addr);
+}
+#endif
+
+void system_init(void)
+{
+#ifndef BOOTLOADER
+    ATJ_TRACE[TR_STAGE] = 3;
+#endif
+    atj_set_priorities();
+#ifndef BOOTLOADER
+    atj_testmode = ATJ_TESTMODE_MAGIC_ADDR == ATJ_TESTMODE_MAGIC ||
+                   ATJ_TESTMODE_MAGIC_ADDR == ATJ_TESTMODE_USB_MAGIC;
+    atj_test_usb = ATJ_TESTMODE_MAGIC_ADDR == ATJ_TESTMODE_USB_MAGIC;
+    ATJ_TESTMODE_MAGIC_ADDR = 0;
+#endif
+    extern char __vectors_arm[];
+    reg_var(CM_SCB_VTOR) = (uint32_t)__vectors_arm;
+
+    atj_watchdog_kick();
+
+    /* SysTick is needed early for udelay() */
+    systick_start();
+}
+
+void tick_start(unsigned int interval_in_ms)
+{
+    systick_interval_in_ms = interval_in_ms;
+    systick_start();
+    reg_writef(CM_SYSTICK_CSR, TICKINT(1));
+}
+
+/* a host test that needs longer than the usual 60 s sets this */
+volatile bool atj_testmode_hold;
+
+void systick_handler(void)
+{
+#ifndef BOOTLOADER
+    /* 30 s up without a reset: tell the NOR boot stub this start worked
+     * (it falls back to USB recovery after three failed ones) */
+    if (current_tick == 30 * HZ)
+        *(volatile uint32_t *)0x00137ff8 = 0;
+#endif
+#ifndef BOOTLOADER
+    extern volatile bool atj_testmode_hold;
+    if (atj_testmode && !atj_testmode_hold && current_tick > 60 * HZ)
+        system_reboot();
+#endif
+    /* NOTE: the watchdog is deliberately not fed here but from the idle
+     * loop (core_sleep), so a hung or panicked system resets itself. */
+    call_tick_tasks();
+}
+
+/* microseconds since boot (tick count + SysTick position), for statistics */
+uint32_t atj_usec(void)
+{
+    uint32_t t, v;
+    do
+    {
+        t = current_tick;
+        v = reg_readf(CM_SYSTICK_CVR, VALUE);
+    } while (t != current_tick);
+    uint32_t max = reg_readf(CM_SYSTICK_RVR, VALUE);
+    return t * (1000000 / HZ) + (max - v) / (SYSTICK_PER_MS / 1000);
+}
+
+void udelay(uint32_t us)
+{
+    uint32_t delay_ticks = us * (SYSTICK_PER_MS / 1000);
+    uint32_t start = reg_readf(CM_SYSTICK_CVR, VALUE);
+    uint32_t max = reg_readf(CM_SYSTICK_RVR, VALUE);
+
+    while (delay_ticks > 0)
+    {
+        uint32_t value = reg_readf(CM_SYSTICK_CVR, VALUE);
+        uint32_t diff = start - value;
+        if (value > start)
+            diff += max;
+
+        if (diff >= delay_ticks)
+            break;
+
+        delay_ticks -= diff;
+        start = value;
+    }
+}
+
+/*
+ * Yield point for long UI operations (UI_YIELD_POINT in the config). The
+ * PCM buffer here lasts ~90 ms; screen changes can run for longer without
+ * blocking, and threads are not preempted. At most once per tick, and only
+ * from thread context with interrupts enabled.
+ */
+void atj_yield_point(void)
+{
+    static long last;
+    if (current_tick == last)
+        return;
+    uint32_t ipsr, basepri, primask;
+    asm volatile ("mrs %0, ipsr" : "=r" (ipsr));
+    asm volatile ("mrs %0, basepri" : "=r" (basepri));
+    asm volatile ("mrs %0, primask" : "=r" (primask));
+    if (ipsr || basepri || primask)
+        return;
+    last = current_tick;
+    yield();
+}
+
+/* reboot into the boot ROM's USB recovery: the NOR boot stub checks this
+ * marker (it survives the watchdog reset) before anything else. The reply
+ * to the host's command gets a moment to go out first. */
+void atj_reboot_to_adfu(void)
+{
+    *(volatile uint32_t *)0x00137ff4 = 0x55464441;     /* "ADFU" */
+    mdelay(50);
+    system_reboot();
+}
+
+void system_reboot(void)
+{
+    /*
+     * SCB_AIRCR.SYSRESETREQ is ignored by this SoC (verified). Reset the
+     * way the vendor firmware does: arm the RTC watchdog with a short
+     * period and let it expire. The boot ROM then re-runs; with the
+     * persistent ADFU flag set it enters ADFU, otherwise it boots NOR.
+     */
+    disable_irq();
+    RTC_WDCTL = ((RTC_WDCTL & ~0xeu) + 6) | 0x11;
+    while (1);
+}
+
+void system_exception_wait(void)
+{
+    /* Show the exception screen for up to ~10 s (or until a key press),
+     * then return so the caller reboots. Interrupts may be off here. */
+    for (int i = 0; i < 1000; i++)
+    {
+        atj_watchdog_kick();
+        if (button_read_device())
+            break;
+        udelay(10000);
+    }
+}
+
+int system_memory_guard(int newmode)
+{
+    (void)newmode;
+    return 0;
+}
diff --git a/firmware/target/arm/atj2157/system-target.h b/firmware/target/arm/atj2157/system-target.h
new file mode 100644
index 0000000..5580b90
--- /dev/null
+++ b/firmware/target/arm/atj2157/system-target.h
@@ -0,0 +1,73 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#ifndef __ATJ2157_SYSTEM_TARGET_H__
+#define __ATJ2157_SYSTEM_TARGET_H__
+
+#include "system-arm.h"
+#include "atj2157.h"
+#include <stdbool.h>
+#include <stdint.h>
+
+/* DMA engines see SRAM2/SRAM3 at different addresses */
+/* yield at most once per tick from long UI operations (UI_YIELD_POINT) */
+void atj_yield_point(void);
+
+static inline uint32_t atj_dma_addr(const void *p)
+{
+    uint32_t a = (uint32_t)p;
+    if (a >= ATJ_SRAM2_BASE && a < ATJ_SRAM2_BASE + ATJ_SRAM2_SIZE)
+        return a - ATJ_SRAM2_BASE + 0x10000000;
+    if (a >= ATJ_SRAM3_BASE && a < ATJ_SRAM3_BASE + ATJ_SRAM3_SIZE)
+        return a - ATJ_SRAM3_BASE + 0x18000000;
+    return a;
+}
+
+static inline void atj_gpio_set(int pin, int high)
+{
+    if (high)
+        GPIO_SET(pin >> 5) = 1u << (pin & 31);
+    else
+        GPIO_CLR(pin >> 5) = 1u << (pin & 31);
+}
+
+
+#define arm_dsb()           asm volatile("dsb" ::: "memory")
+#define arm_isb()           asm volatile("isb" ::: "memory")
+
+/* No caches on this core: the maintenance operations are no-ops, but they
+ * must be real functions since the plugin/codec APIs take their address. */
+void commit_discard_idcache(void);
+void commit_discard_dcache(void);
+void commit_dcache(void);
+void discard_dcache_range(const void *base, unsigned int size);
+void commit_dcache_range(const void *base, unsigned int size);
+
+/* Busy loop delay based on SysTick */
+void udelay(uint32_t us);
+static inline void mdelay(uint32_t ms) { while (ms--) udelay(1000); }
+
+/* Feed the RTC watchdog (it is armed by the boot ROM) */
+static inline void atj_watchdog_kick(void) { RTC_WDCTL |= 1; }
+
+/* Pulse a block reset and enable its clock */
+void atj_module_enable(uint32_t rst_bit, uint32_t clk_bit);
+
+uint32_t atj_usec(void);
+#define USEC_TIMER atj_usec()
+
+#endif /* __ATJ2157_SYSTEM_TARGET_H__ */
diff --git a/firmware/target/arm/atj2157/timer-atj2157.c b/firmware/target/arm/atj2157/timer-atj2157.c
