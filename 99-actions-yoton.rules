# Actions Semiconductor (VID 10d6) MP3 players, e.g. Yoton YM03/YM04/YM05.
# Grants the logged-in user raw access to the USB device node (for libusb /
# ADFU tools) and to the SCSI generic + block nodes (for vendor SCSI commands).
#
# Install:
#   sudo cp 99-actions-yoton.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
# then unplug / replug the player.

SUBSYSTEM=="usb", ATTR{idVendor}=="10d6", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="10d6", SUBSYSTEM=="scsi_generic", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="10d6", SUBSYSTEM=="block", MODE="0666", TAG+="uaccess"
